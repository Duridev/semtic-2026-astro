---
import { projectsData } from '../data/projects';
---

<!-- MODAL INTERACTIVO DE DETALLES DE PROYECTO (EXECUTIVE CASE STUDY) -->
<div 
  id="project-modal-backdrop"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 md:p-6 bg-[#02020a]/85 backdrop-blur-xl opacity-0 pointer-events-none transition-all duration-300 ease-out"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-project-title"
>
  <div 
    id="project-modal-card"
    class="relative w-full max-w-5xl max-h-[92vh] flex flex-col bg-[#08091a]/95 border border-white/15 rounded-3xl shadow-[0_30px_80px_-15px_rgba(0,0,0,0.95),0_0_50px_rgba(0,242,234,0.18)] backdrop-blur-2xl overflow-hidden transform scale-95 translate-y-3 transition-all duration-300 ease-out"
  >
    <!-- Línea superior de luz neón -->
    <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-[#00f2ea] to-transparent z-20"></div>

    <!-- Header de la Modal -->
    <div class="px-5 py-4 sm:px-7 sm:py-5 border-b border-white/10 flex items-center justify-between bg-[#050511]/80 shrink-0">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-[#2dd4bf]/15 border border-[#2dd4bf]/35 text-[#2dd4bf]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#2dd4bf] animate-pulse"></span>
          Caso de Éxito Verificado
        </span>
        <span 
          id="modal-project-badge" 
          class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-[#00f2ea]/10 border border-[#00f2ea]/30 text-[#00f2ea]"
        >
          Proyecto SEMTIC
        </span>
      </div>

      <!-- Botón de Cerrar Cuadrado Moderno -->
      <button 
        type="button" 
        id="modal-close-btn"
        class="w-10 h-10 rounded-xl bg-white/5 hover:bg-red-500/20 border border-white/15 hover:border-red-400/50 text-gray-300 hover:text-white flex items-center justify-center transition-all duration-200 cursor-pointer active:scale-95 group"
        aria-label="Cerrar modal"
      >
        <svg class="w-5 h-5 transition-transform duration-200 group-hover:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Contenido con Scroll Suave -->
    <div class="p-5 sm:p-7 md:p-8 overflow-y-auto space-y-7 custom-scrollbar">
      
      <!-- Bloque Superior: Mockup de Navegador + Resumen Ejecutivo -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        
        <!-- Columna Izquierda (7 cols): Simulación de Navegador Web + Telemetría -->
        <div class="lg:col-span-7 flex flex-col justify-between rounded-2xl overflow-hidden border border-white/15 bg-[#050511] shadow-2xl">
          <!-- Barra de navegador simulada -->
          <div class="px-4 py-2.5 bg-[#0d0e24] border-b border-white/10 flex items-center justify-between gap-3">
            <div class="flex items-center gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
            </div>
            <div class="flex-1 max-w-xs mx-auto px-3 py-1 rounded-lg bg-black/50 border border-white/10 text-xs text-gray-300 font-mono truncate flex items-center justify-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[#2dd4bf] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <span id="modal-browser-url">https://semtic.cl</span>
            </div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#39ff14] bg-[#39ff14]/10 border border-[#39ff14]/30 px-2 py-0.5 rounded-md hidden sm:inline-block">
              SSL Activo
            </span>
          </div>

          <!-- Imagen del Proyecto con Overlay Hover -->
          <div class="relative aspect-video w-full overflow-hidden bg-black/60 group/preview">
            <img 
              id="modal-project-img" 
              src="/tmquinta-hero.webp" 
              alt="Captura del sitio web" 
              class="w-full h-full object-cover group-hover/preview:scale-105 transition-transform duration-700" 
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#050511] via-transparent to-transparent opacity-60"></div>
            <a
              id="modal-preview-floating-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="absolute bottom-3.5 right-3.5 px-4 py-2 rounded-xl bg-[#050511]/90 hover:bg-[#00f2ea] text-white hover:text-[#050511] border border-[#00f2ea]/50 text-xs font-bold backdrop-blur-md flex items-center gap-1.5 shadow-xl transition-all duration-300"
            >
              <span>Ver sitio en vivo</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>

          <!-- Barra de Telemetría Core Web Vitals -->
          <div class="grid grid-cols-3 divide-x divide-white/10 border-t border-white/10 bg-[#080a1c] text-center py-2.5 px-2">
            <div>
              <div class="text-[10px] uppercase tracking-wider text-gray-400">PageSpeed</div>
              <div class="text-xs sm:text-sm font-bold text-[#39ff14] font-[family-name:var(--font-space-grotesk)]">99 / 100</div>
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-wider text-gray-400">Carga Móvil</div>
              <div class="text-xs sm:text-sm font-bold text-[#00f2ea] font-[family-name:var(--font-space-grotesk)]">&lt; 0.8 Seg</div>
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-wider text-gray-400">Conversión</div>
              <div class="text-xs sm:text-sm font-bold text-[#2dd4bf] font-[family-name:var(--font-space-grotesk)]">WhatsApp Directo</div>
            </div>
          </div>
        </div>

        <!-- Columna Derecha (5 cols): Identidad del Proyecto + Impacto Comercial -->
        <div class="lg:col-span-5 flex flex-col justify-between p-6 rounded-2xl bg-gradient-to-b from-white/[0.04] to-white/[0.01] border border-white/10">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-widest text-[#2dd4bf] block mb-1">Ficha Técnica del Proyecto</span>
            <h2 
              id="modal-project-title" 
              class="text-2xl sm:text-3xl font-bold text-white font-[family-name:var(--font-space-grotesk)] leading-tight"
            >
              Nombre del Proyecto
            </h2>
            <p 
              id="modal-project-subtitle" 
              class="text-[#00f2ea] text-sm font-medium mt-1 mb-4"
            >
              Subtítulo o categoría
            </p>

            <!-- Badges de Tecnologías / Stack aplicadas -->
            <div class="mb-5">
              <div class="text-[10px] uppercase tracking-wider text-gray-400 font-bold mb-2">Stack &amp; Especialidades Aplicadas</div>
              <div id="modal-project-tags" class="flex flex-wrap gap-1.5 items-center">
                <!-- Badges renderizados dinámicamente -->
              </div>
            </div>
          </div>

          <!-- Tarjeta de Impacto Comercial con Miniatura 3D -->
          <div id="modal-project-additional-container" class="p-4 rounded-2xl bg-[#050511]/90 border border-[#2dd4bf]/30 flex items-center gap-3.5 shadow-inner">
            <div class="w-14 h-14 rounded-xl overflow-hidden border border-[#2dd4bf]/40 shrink-0 bg-[#050511]">
              <img src="/servicios-img/about-pyme-focus.jpg" alt="Impacto comercial del proyecto" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-[#2dd4bf] block mb-0.5">Resultado &amp; Objetivo Logrado</span>
              <p id="modal-project-additional" class="text-xs text-gray-200 leading-relaxed font-light">
                Información adicional sobre resultados o impacto del proyecto.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Grilla de Información Detallada (Para quién fue creado y particularidad con imágenes 3D) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        
        <!-- Tarjeta 1: ¿Para quién fue creado? -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#050511]/75 border border-white/10 hover:border-[#00f2ea]/40 transition-colors">
          <div class="flex items-center gap-3.5 mb-3.5">
            <div class="w-12 h-12 rounded-xl overflow-hidden border border-[#00f2ea]/40 shrink-0 bg-[#050511]">
              <img src="/mktn-img/paso-01-diagnostico.jpg" alt="Perfil del cliente y mercado objetivo" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-[#00f2ea] block">Mercado &amp; Audiencia</span>
              <h3 class="text-lg font-bold text-white font-[family-name:var(--font-space-grotesk)]">
                ¿Para quién fue creado?
              </h3>
            </div>
          </div>
          <p 
            id="modal-project-audience" 
            class="text-gray-300 text-xs sm:text-sm leading-relaxed font-light"
          >
            Descripción del cliente objetivo, rubro y necesidades comerciales específicas.
          </p>
        </div>

        <!-- Tarjeta 2: ¿Cuál es su particularidad? -->
        <div class="p-5 sm:p-6 rounded-2xl bg-[#050511]/75 border border-white/10 hover:border-[#3b82f6]/40 transition-colors">
          <div class="flex items-center gap-3.5 mb-3.5">
            <div class="w-12 h-12 rounded-xl overflow-hidden border border-[#3b82f6]/40 shrink-0 bg-[#050511]">
              <img src="/web-img/web-astro-veloz.jpg" alt="Ingeniería aplicada y solución técnica" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-[#60a5fa] block">Ingeniería SEMTIC</span>
              <h3 class="text-lg font-bold text-white font-[family-name:var(--font-space-grotesk)]">
                Particularidad &amp; Solución Técnica
              </h3>
            </div>
          </div>
          <p 
            id="modal-project-particularity" 
            class="text-gray-300 text-xs sm:text-sm leading-relaxed font-light"
          >
            Detalles técnicos clave, arquitectura de velocidad y soluciones a la medida implementadas por SEMTIC.
          </p>
        </div>
      </div>

      <!-- Sección de Características Destacadas en Tarjetas Glass -->
      <div class="p-5 sm:p-6 rounded-2xl bg-white/[0.02] border border-white/10">
        <h4 class="text-xs uppercase tracking-widest font-bold text-[#2dd4bf] mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#2dd4bf]"></span>
          Entregables e Implementaciones Clave del Proyecto
        </h4>
        <ul id="modal-project-highlights" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- Renderizado dinámico vía script -->
        </ul>
      </div>

    </div>

    <!-- Footer con Botones de Acción 3D Glassmorphism -->
    <div class="px-5 py-4 sm:px-7 sm:py-5 border-t border-white/10 bg-[#050511]/95 flex flex-col sm:flex-row items-center justify-between gap-3 shrink-0">
      <button 
        type="button" 
        id="modal-close-footer-btn"
        class="w-full sm:w-auto px-5 py-2.5 rounded-xl border border-white/15 bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white font-semibold text-xs sm:text-sm transition-all cursor-pointer"
      >
        ← Volver al Portafolio
      </button>

      <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
        <a 
          id="modal-project-link" 
          href="#" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-semtic-secondary w-full sm:w-auto px-5 py-3 text-xs sm:text-sm font-bold flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Visitar Sitio en Vivo</span>
          <svg class="w-4 h-4 text-[#00f2ea]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>

        <a 
          id="modal-whatsapp-quote-link"
          href="https://wa.me/56988169404" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-semtic-primary w-full sm:w-auto px-6 py-3 text-xs sm:text-sm font-extrabold uppercase flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          <span>Cotizar Proyecto Similar</span>
        </a>
      </div>
    </div>

  </div>
</div>

<!-- Script del Modal -->
<script define:vars={{ projectsData }}>
  (function () {
    const backdrop = document.getElementById('project-modal-backdrop');
    const card = document.getElementById('project-modal-card');
    const closeBtn = document.getElementById('modal-close-btn');
    const closeFooterBtn = document.getElementById('modal-close-footer-btn');

    // Elementos dinámicos del modal
    const badgeEl = document.getElementById('modal-project-badge');
    const browserUrlEl = document.getElementById('modal-browser-url');
    const imgEl = document.getElementById('modal-project-img');
    const titleEl = document.getElementById('modal-project-title');
    const subtitleEl = document.getElementById('modal-project-subtitle');
    const tagsEl = document.getElementById('modal-project-tags');
    const audienceEl = document.getElementById('modal-project-audience');
    const particularityEl = document.getElementById('modal-project-particularity');
    const highlightsEl = document.getElementById('modal-project-highlights');
    const additionalContainer = document.getElementById('modal-project-additional-container');
    const additionalEl = document.getElementById('modal-project-additional');
    const linkEl = document.getElementById('modal-project-link');
    const floatingPreviewLinkEl = document.getElementById('modal-preview-floating-link');
    const waQuoteLinkEl = document.getElementById('modal-whatsapp-quote-link');

    function openModal(projectId) {
      const project = projectsData.find((p) => p.id === projectId);
      if (!project) return;

      // Asignar datos
      if (badgeEl) badgeEl.textContent = project.category;
      if (browserUrlEl) browserUrlEl.textContent = project.url;
      if (imgEl) {
        imgEl.src = project.image;
        imgEl.alt = `${project.title} - ${project.subtitle}`;
      }
      if (titleEl) titleEl.textContent = project.title;
      if (subtitleEl) subtitleEl.textContent = project.subtitle;

      if (tagsEl) {
        tagsEl.innerHTML = '';
        project.tags.forEach((tag) => {
          const span = document.createElement('span');
          span.className = `px-3 py-1 border rounded-lg text-[11px] font-bold ${project.accentBgClass}`;
          span.textContent = tag;
          tagsEl.appendChild(span);
        });
      }

      if (audienceEl) audienceEl.textContent = project.targetAudience;
      if (particularityEl) particularityEl.textContent = project.particularity;

      if (highlightsEl) {
        highlightsEl.innerHTML = '';
        project.highlights.forEach((item) => {
          const li = document.createElement('li');
          li.className = 'p-3.5 rounded-xl bg-[#050511]/80 border border-white/10 flex items-start gap-2.5 text-xs sm:text-sm text-gray-200';
          li.innerHTML = `
            <span class="w-5 h-5 rounded-md bg-[#2dd4bf]/15 border border-[#2dd4bf]/40 text-[#2dd4bf] flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">✓</span>
            <span>${item}</span>
          `;
          highlightsEl.appendChild(li);
        });
      }

      if (additionalContainer && additionalEl) {
        if (project.additionalInfo) {
          additionalContainer.classList.remove('hidden');
          additionalEl.textContent = project.additionalInfo;
        } else {
          additionalContainer.classList.add('hidden');
        }
      }

      if (linkEl) {
        linkEl.href = project.url;
      }
      if (floatingPreviewLinkEl) {
        floatingPreviewLinkEl.href = project.url;
      }
      if (waQuoteLinkEl) {
        const msg = encodeURIComponent(`Hola SEMTIC! Vi el caso de éxito de ${project.title} en su portafolio y me gustaría cotizar un proyecto similar para mi empresa.`);
        waQuoteLinkEl.href = `https://wa.me/56988169404?text=${msg}`;
      }

      // Mostrar modal con animación fluida
      if (backdrop && card) {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
        card.classList.remove('scale-95', 'translate-y-3');
        card.classList.add('scale-100', 'translate-y-0');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal() {
      if (backdrop && card) {
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        card.classList.add('scale-95', 'translate-y-3');
        card.classList.remove('scale-100', 'translate-y-0');
        document.body.style.overflow = '';
      }
    }

    // Delegación de eventos para abrir modal
    document.addEventListener('click', (e) => {
      const target = e.target;
      const trigger = target.closest('[data-open-modal]');
      if (trigger) {
        e.preventDefault();
        const projectId = trigger.getAttribute('data-open-modal');
        if (projectId) openModal(projectId);
        return;
      }

      if (target === backdrop) {
        closeModal();
      }
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (closeFooterBtn) closeFooterBtn.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop && backdrop.classList.contains('opacity-100')) {
        closeModal();
      }
    });
  })();
</script>
