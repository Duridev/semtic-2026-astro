---
interface FAQItem {
    question: string;
    answer: string;
}

interface Props {
    customFaqs?: FAQItem[];
}

const { customFaqs } = Astro.props;

// Schema.org JSON-LD structured data for SEO (Valparaíso & Región Metropolitana de Santiago)
const organizationSchema = {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "ProfessionalService", "MarketingAgency"],
    "@id": "https://semtic.cl/#organization",
    name: "SEMTIC Agencia Digital",
    alternateName: "Agencia SEMTIC - Landing Pages, Google Ads y Meta Ads",
    url: "https://semtic.cl",
    logo: "https://semtic.cl/logo-semtic.png",
    image: "https://semtic.cl/social-img.webp",
    description:
        "Agencia digital especialista en diseño de Landing Pages de alta conversión, desarrollo web en Astro y gestión de campañas publicitarias en Google Ads y Meta Ads en la Región de Valparaíso y Región Metropolitana de Santiago.",
    address: {
        "@type": "PostalAddress",
        streetAddress: "Echaurren 97",
        addressLocality: "Limache",
        addressRegion: "Región de Valparaíso",
        postalCode: "2280000",
        addressCountry: "CL",
    },
    geo: {
        "@type": "GeoCoordinates",
        latitude: -33.0016,
        longitude: -71.2667,
    },
    areaServed: [
        { "@type": "AdministrativeArea", name: "Región de Valparaíso" },
        { "@type": "AdministrativeArea", name: "Región Metropolitana de Santiago" },
        { "@type": "City", name: "Santiago" },
        { "@type": "City", name: "Providencia" },
        { "@type": "City", name: "Las Condes" },
        { "@type": "City", name: "Vitacura" },
        { "@type": "City", name: "Ñuñoa" },
        { "@type": "City", name: "Viña del Mar" },
        { "@type": "City", name: "Valparaíso" },
        { "@type": "City", name: "Concón" },
        { "@type": "City", name: "Quilpué" },
        { "@type": "City", name: "Villa Alemana" },
        { "@type": "City", name: "Limache" },
        { "@type": "City", name: "Quillota" },
        { "@type": "City", name: "Marga Marga" }
    ],
    sameAs: [
        "https://www.facebook.com/semtic.consultora",
        "https://www.instagram.com/semtic.cl",
        "https://www.linkedin.com/company/semtic",
        "https://www.tiktok.com/@semtic.cl",
        "https://www.youtube.com/@AgenciaSemtic",
    ],
    contactPoint: {
        "@type": "ContactPoint",
        telephone: "+56988169404",
        email: "somos@semtic.cl",
        contactType: "sales",
        areaServed: ["CL-VS", "CL-RM", "CL"],
        availableLanguage: "es",
    },
    priceRange: "$$",
    knowsAbout: [
        "Landing Page",
        "Diseño de Landing Pages de Alta Conversión",
        "Google Ads",
        "Agencia Google Ads",
        "Meta Ads",
        "Agencia Meta Ads",
        "Campaña Publicitaria Digital",
        "Agencia de Marketing Digital en Valparaíso y Santiago",
        "Desarrollo Web en Astro",
        "Posicionamiento SEO Local"
    ],
};

const servicesSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Diseño de Landing Page y Campañas Publicitarias en Google Ads y Meta Ads",
    provider: {
        "@type": "Organization",
        name: "SEMTIC Agencia Digital",
        url: "https://semtic.cl",
    },
    areaServed: [
        "Región de Valparaíso",
        "Región Metropolitana de Santiago",
        "Santiago",
        "Viña del Mar",
        "Valparaíso"
    ],
    hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Servicios de Adquisición Comercial y Marketing Digital",
        itemListElement: [
            {
                "@type": "Offer",
                itemOffered: {
                    "@type": "Service",
                    name: "Diseño de Landing Pages y Desarrollo Web en Astro",
                    description:
                        "Creación de Landing Pages ultrarrápidas y sitios web orientados a generar prospectos y cotizaciones por WhatsApp en Santiago y Región de Valparaíso.",
                },
            },
            {
                "@type": "Offer",
                itemOffered: {
                    "@type": "Service",
                    name: "Agencia Google Ads (Campañas de Búsqueda y SEM)",
                    description:
                        "Gestión profesional de campañas publicitarias en Google Ads enfocadas en palabras clave con alta intención de compra.",
                },
            },
            {
                "@type": "Offer",
                itemOffered: {
                    "@type": "Service",
                    name: "Agencia Meta Ads (Publicidad en Instagram y Facebook)",
                    description:
                        "Campañas publicitarias de captación de leads y remarketing en Meta Ads para pymes y empresas de servicios.",
                },
            },
            {
                "@type": "Offer",
                itemOffered: {
                    "@type": "Service",
                    name: "Posicionamiento SEO Local",
                    description:
                        "Optimización SEO técnica y local para posicionar empresas en Google en la Región Metropolitana y Región de Valparaíso.",
                },
            },
        ],
    },
};

const defaultFaqs: FAQItem[] = [
    {
        question: "¿Cuánto demora tener mi Landing Page o página web lista?",
        answer: "Una Landing Page comercial de alta conversión está lista entre 7 y 15 días hábiles; un e-commerce o sitio corporativo completo, entre 15 y 30 días.",
    },
    {
        question: "¿Cómo funcionan las campañas publicitarias en Google Ads y Meta Ads?",
        answer: "Estructuramos campañas segmentadas en la Región de Valparaíso y Región Metropolitana de Santiago apuntando a usuarios con intención real de compra, conectando los anuncios a una Landing Page rápida con contacto directo a WhatsApp.",
    },
    {
        question: "¿Qué incluye el diseño de una Landing Page en SEMTIC?",
        answer: "Incluye desarrollo ultrarrápido en Astro, diseño mobile-first, redacción comercial persuasiva, botones de conversión directa a WhatsApp y configuración de analítica (Google Tag Manager y GA4).",
    },
    {
        question: "¿Atienden empresas en Santiago y en la Región de Valparaíso?",
        answer: "Sí, trabajamos de forma directa con empresas, profesionales y pymes tanto en la Región Metropolitana de Santiago como en toda la Región de Valparaíso (Viña del Mar, Valparaíso, Concón, Quilpué, Limache y Quillota).",
    },
];

const activeFaqs = customFaqs && customFaqs.length > 0 ? customFaqs : defaultFaqs;

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: activeFaqs.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
        },
    })),
};
---

<script
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema)}
/>
<script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
