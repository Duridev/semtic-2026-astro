---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout 
    title="Contáctanos | Asesoría Digital Gratis en Chile | SEMTIC" 
    description="¿Necesitas desarrollo web, SEO o publicidad digital? Habla con el equipo de SEMTIC vía WhatsApp, email o teléfono. Asesoría inicial sin costo."
    image="https://semtic.cl/social-img.webp">

    <!-- SECCIÓN 1: HERO -->
    <section class="relative min-h-[60vh] flex items-center justify-center pt-32 pb-20 overflow-hidden" style="z-index: 10;">
        <!-- Resplandores neón -->
        <div class="absolute top-1/4 left-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#25D366] rounded-full mix-blend-screen filter blur-[140px] opacity-20 animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#2dd4bf] rounded-full mix-blend-screen filter blur-[140px] opacity-20 animate-pulse" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/3 right-10 w-64 h-64 bg-[#3b82f6] rounded-full mix-blend-screen filter blur-[120px] opacity-15"></div>

        <div class="relative z-10 text-center px-4 max-w-5xl mx-auto hero-container">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-[#25D366]/40 backdrop-blur-md mb-6">
                <span class="w-2 h-2 rounded-full bg-[#25D366] animate-ping"></span>
                <span class="text-xs uppercase tracking-widest text-[#25D366] font-bold">📞 Contacto Directo & Diagnóstico Gratuito</span>
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-[family-name:var(--font-space-grotesk)] font-bold mb-6 leading-tight text-white">
                Hablemos de tu <span class="text-gradient">Proyecto Digital</span>
            </h1>

            <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto mb-10 font-light leading-relaxed">
                Cuéntanos sobre tus objetivos. Analizamos tus necesidades, diseñamos la solución perfecta y te entregamos un presupuesto transparente sin compromiso.
            </p>
        </div>
    </section>

    <!-- SECCIÓN 2: CONTACTO PRIORITARIO WHATSAPP -->
    <section class="py-12 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-4xl">
            <div class="p-10 md:p-14 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0b1c15] to-[#0a0a20] border border-[#25D366]/40 backdrop-blur-xl text-center relative overflow-hidden shadow-2xl">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-1 bg-gradient-to-r from-transparent via-[#25D366] to-transparent"></div>
                
                <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-[#25D366]/10 text-[#25D366] border border-[#25D366]/30 mb-4 inline-block">
                    ⚡ Canal Más Rápido
                </span>

                <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white font-[family-name:var(--font-space-grotesk)]">
                    Contáctanos Directamente por WhatsApp
                </h2>

                <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto mb-8 font-light leading-relaxed">
                    Obtén atención rápida de un especialista. Cuéntanos sobre tu negocio o consulta por un servicio en específico.
                </p>

                <a href="https://wa.me/56988169404?text=Hola%20Semtic!%20Quiero%20agendar%20una%20reunión%20o%20recibir%20asesoría" target="_blank" class="inline-flex items-center justify-center px-10 py-5 bg-gradient-to-r from-[#25D366] to-[#2dd4bf] rounded-full text-[#050511] font-extrabold text-base md:text-lg tracking-wide shadow-lg hover:shadow-[0_0_40px_rgba(37,211,102,0.6)] transition-all duration-300 transform hover:-translate-y-1 gap-3 uppercase">
                    <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                    Abrir Chat de WhatsApp
                </a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3: CANALES DE CONTACTO (3 Tarjetas Glassmórficas) -->
    <section class="py-20 relative bg-gradient-to-b from-transparent via-[#0a0a20]/60 to-transparent" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    Otras Vías de <span class="text-gradient">Comunicación</span>
                </h2>
                <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto font-light">
                    Selecciona el medio de contacto que te resulte más cómodo.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Tarjeta WhatsApp -->
                <a href="https://wa.me/56988169404?text=Hola%20Semtic!%20Quisiera%20hacer%20una%20consulta%20por%20sus%20servicios." target="_blank" class="group relative p-8 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl hover:border-[#25D366]/50 transition-all duration-500 hover:-translate-y-1.5 shadow-xl text-center flex flex-col items-center justify-between">
                    <div>
                        <div class="w-16 h-16 mb-6 mx-auto rounded-2xl bg-[#25D366]/10 border border-[#25D366]/30 flex items-center justify-center text-[#25D366] group-hover:scale-110 transition-transform">
                            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                        </div>
                        <h3 class="text-xl font-bold mb-2 text-white font-[family-name:var(--font-space-grotesk)]">WhatsApp Business</h3>
                        <p class="text-gray-400 text-xs mb-4">Respuesta rápida & agendamiento</p>
                    </div>
                    <span class="text-[#25D366] text-xs font-semibold uppercase tracking-wider group-hover:underline">Escribir por WhatsApp →</span>
                </a>

                <!-- Tarjeta Email -->
                <a href="mailto:contacto@semtic.cl" class="group relative p-8 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl hover:border-[#00f2ea]/50 transition-all duration-500 hover:-translate-y-1.5 shadow-xl text-center flex flex-col items-center justify-between">
                    <div>
                        <div class="w-16 h-16 mb-6 mx-auto rounded-2xl bg-[#00f2ea]/10 border border-[#00f2ea]/30 flex items-center justify-center text-[#00f2ea] group-hover:scale-110 transition-transform">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        </div>
                        <h3 class="text-xl font-bold mb-2 text-white font-[family-name:var(--font-space-grotesk)]">Correo Electrónico</h3>
                        <p class="text-gray-400 text-xs mb-4">contacto@semtic.cl</p>
                    </div>
                    <span class="text-[#00f2ea] text-xs font-semibold uppercase tracking-wider group-hover:underline">Enviar Email →</span>
                </a>

                <!-- Tarjeta Teléfono -->
                <a href="tel:+56988169404" class="group relative p-8 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl hover:border-[#3b82f6]/50 transition-all duration-500 hover:-translate-y-1.5 shadow-xl text-center flex flex-col items-center justify-between">
                    <div>
                        <div class="w-16 h-16 mb-6 mx-auto rounded-2xl bg-[#3b82f6]/10 border border-[#3b82f6]/30 flex items-center justify-center text-[#3b82f6] group-hover:scale-110 transition-transform">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        </div>
                        <h3 class="text-xl font-bold mb-2 text-white font-[family-name:var(--font-space-grotesk)]">Llamada Directa</h3>
                        <p class="text-gray-400 text-xs mb-4">+56 9 8816 9404</p>
                    </div>
                    <span class="text-[#3b82f6] text-xs font-semibold uppercase tracking-wider group-hover:underline">Llamar Ahora →</span>
                </a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 4: HORARIOS Y COBERTURA -->
    <section class="py-20 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-5xl">
            <div class="grid md:grid-cols-2 gap-8">
                <!-- Horarios de Atención -->
                <div class="p-8 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-12 h-12 rounded-2xl bg-[#2dd4bf]/10 border border-[#2dd4bf]/30 flex items-center justify-center text-[#2dd4bf]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white font-[family-name:var(--font-space-grotesk)]">Horarios de Atención</h3>
                    </div>
                    <div class="space-y-3 text-gray-300 text-sm font-light">
                        <div class="flex justify-between border-b border-white/5 pb-2">
                            <span>Lunes a Viernes:</span>
                            <span class="text-[#2dd4bf] font-semibold">9:00 - 18:00 hrs</span>
                        </div>
                        <div class="flex justify-between border-b border-white/5 pb-2">
                            <span>Sábados:</span>
                            <span class="text-[#2dd4bf] font-semibold">10:00 - 14:00 hrs</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Domingos:</span>
                            <span class="text-gray-400">Atención vía WhatsApp</span>
                        </div>
                    </div>
                </div>

                <!-- Cobertura Regional -->
                <div class="p-8 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-12 h-12 rounded-2xl bg-[#4f46e5]/10 border border-[#4f46e5]/30 flex items-center justify-center text-[#4f46e5]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white font-[family-name:var(--font-space-grotesk)]">Cobertura Nacional</h3>
                    </div>
                    <div class="text-gray-300 text-sm font-light space-y-2">
                        <p>📍 <strong>Región de Valparaíso:</strong> Limache, Viña del Mar, Valparaíso, Concón, Quilpué, Villa Alemana, Quillota.</p>
                        <p>📍 <strong>Región Metropolitana:</strong> Santiago y comunas aledañas.</p>
                        <p>📍 <strong>Resto de Chile:</strong> Atención y proyectos en todas las regiones del territorio nacional.</p>
                        <p class="text-xs text-gray-400 pt-2 border-t border-white/5">* Atención presencial con agendamiento previo y reuniones virtuales vía Google Meet / Zoom.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 5: BANNER AL BLOG -->
    <section class="py-10 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-5xl">
            <div class="p-8 md:p-10 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0d123b] to-[#0a0a20] border border-[#2dd4bf]/40 backdrop-blur-xl relative overflow-hidden shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="max-w-2xl">
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[#2dd4bf]/10 border border-[#2dd4bf]/30 text-[#2dd4bf] mb-3 inline-block">
                        📖 Conoce Nuestro Trabajo
                    </span>
                    <h3 class="text-xl md:text-2xl font-bold text-white mb-2 font-[family-name:var(--font-space-grotesk)]">
                        Explora los Artículos y Guías en el Blog SEMTIC
                    </h3>
                    <p class="text-gray-300 text-sm font-light leading-relaxed">
                        Aprende más sobre nuestras metodologías en desarrollo web, posicionamiento SEO y servicios audiovisuales con dron.
                    </p>
                </div>
                <a href="/blog" class="px-6 py-3.5 rounded-full bg-[#2dd4bf] text-[#050511] font-semibold text-sm hover:bg-[#00f2ea] hover:shadow-[0_0_20px_rgba(0,242,234,0.5)] transition-all whitespace-nowrap">
                    Ir al Blog →
                </a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 6: CTA FINAL -->
    <section class="py-24 relative overflow-hidden" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-5xl">
            <div class="p-10 md:p-14 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0e103b] to-[#0a0a20] border border-[#25D366]/40 backdrop-blur-xl text-center relative overflow-hidden shadow-2xl">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-1 bg-gradient-to-r from-transparent via-[#25D366] to-transparent"></div>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold mb-6 text-white leading-tight">
                    ¿Prefieres una <span class="text-gradient">reunión virtual</span>?
                </h2>
                <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto mb-8 font-light leading-relaxed">
                    Agenda una llamada gratuita de 15 minutos para analizar tu proyecto y orientarte sobre los mejores pasos a seguir.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <a href="https://wa.me/56988169404?text=Hola,%20quisiera%20agendar%20una%20reunión%20virtual" target="_blank" class="px-8 py-4 rounded-full bg-gradient-to-r from-[#25D366] to-[#2dd4bf] text-[#050511] font-extrabold text-sm uppercase tracking-wide hover:shadow-[0_0_30px_rgba(37,211,102,0.6)] transition-all transform hover:-translate-y-1 flex items-center gap-2">
                        📅 Agendar Reunión Virtual
                    </a>
                </div>
            </div>
        </div>
    </section>

</Layout>
