---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const quickWhatsappTopics = [
    {
        title: "Landing Page o Sitio Web en Astro",
        subtitle: "Carga en < 1 segundo • Entrega desde 5 días",
        desc: "Ideal si necesitas una página web ultra rápida diseñada para transformar visitas en cotizaciones por WhatsApp.",
        image: "/web-img/solucion-landing.jpg",
        badge: "Desarrollo Web",
        color: "#00f2ea",
        waText: "Hola%20SEMTIC!%20Quiero%20cotizar%20una%20Landing%20Page%20o%20Sitio%20Web%20de%20alta%20conversi%C3%B3n"
    },
    {
        title: "Campañas en Google Ads y Meta Ads",
        subtitle: "Tráfico calificado • Medición con GA4 y Píxel",
        desc: "Ideal si buscas captar prospectos inmediatos en tu ciudad con anuncios medibles y optimizados para retorno (ROI).",
        image: "/ads-img/canal-google-ads.jpg",
        badge: "Publicidad Pagada",
        color: "#39ff14",
        waText: "Hola%20SEMTIC!%20Quiero%20cotizar%20una%20campa%C3%B1a%20publicitaria%20en%20Google%20Ads%20o%20Meta%20Ads"
    },
    {
        title: "Agencia de Marketing & SEO Local",
        subtitle: "Posicionamiento en Google • Embudos B2B/B2C",
        desc: "Ideal para empresas que buscan dominar las búsquedas orgánicas en su región y escalar su facturación mes a mes.",
        image: "/mktn-img/estrategia-semtic.jpg",
        badge: "Growth & SEO",
        color: "#2dd4bf",
        waText: "Hola%20SEMTIC!%20Quiero%20asesor%C3%ADa%20sobre%20Marketing%20Digital%20y%20Posicionamiento%20SEO"
    },
    {
        title: "Grabación 4K e Inspección con Dron",
        subtitle: "Normativa DGAC • Valparaíso, Santiago y Chile",
        desc: "Ideal para constructoras, inmobiliarias, industrias y eventos que requieren registro aéreo profesional o fotogrametría.",
        image: "/cards-img/Inspecciones & Ingeniería.webp",
        badge: "Drones DGAC",
        color: "#3b82f6",
        waText: "Hola%20SEMTIC!%20Quiero%20cotizar%20un%20servicio%20de%20grabaci%C3%B3n%20o%20inspecci%C3%B3n%20con%20Dron"
    }
];

const diagnosticSteps = [
    {
        step: "01",
        title: "Contacto Directo con Especialistas",
        desc: "Nos escribes por WhatsApp, correo o teléfono. Hablas directamente con los ingenieros y estrategas que ejecutarán tu proyecto, sin ejecutivos de venta ni burocracia.",
        image: "/mktn-img/paso-01-diagnostico.jpg",
        color: "#00f2ea",
        tag: "Respuesta inmediata"
    },
    {
        step: "02",
        title: "Auditoría de tu Negocio y Competencia",
        desc: "Analizamos sin costo tu situación actual, qué están haciendo tus competidores en Google y Meta en tu zona (Valparaíso o Santiago) y dónde están las oportunidades rápidas de venta.",
        image: "/mktn-img/paso-02-funnel.jpg",
        color: "#2dd4bf",
        tag: "100% sin compromiso"
    },
    {
        step: "03",
        title: "Propuesta Clara en Menos de 24 Horas",
        desc: "Te entregamos una hoja de ruta técnica y comercial transparente: plazos exactos de entrega, alcance detallado y valores cerrados sin cobros ocultos ni amarres.",
        image: "/servicios-img/faq-steps-leads.jpg",
        color: "#39ff14",
        tag: "Presupuesto transparente"
    }
];
---

<Layout 
    title="Contacto y Diagnóstico Digital Gratis en Valparaíso y Santiago" 
    description="Habla directo con los ingenieros y especialistas de SEMTIC. Cotiza tu Landing Page en Astro, campañas en Google Ads y Meta Ads, SEO Local o vuelos con Dron DGAC en la Región de Valparaíso y Región Metropolitana de Santiago."
    image="https://semtic.cl/social-img.webp">

    <!-- SECCIÓN 1: HERO -->
    <section class="relative min-h-[65vh] flex items-center justify-center pt-32 pb-16 overflow-hidden" style="z-index: 10;">
        <!-- Resplandores neón -->
        <div class="absolute top-1/4 left-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#25D366] rounded-full mix-blend-screen filter blur-[140px] opacity-20 animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#2dd4bf] rounded-full mix-blend-screen filter blur-[140px] opacity-20 animate-pulse" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/3 right-10 w-64 h-64 bg-[#3b82f6] rounded-full mix-blend-screen filter blur-[120px] opacity-15"></div>

        <div class="relative z-10 text-center px-4 max-w-5xl mx-auto hero-container">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-[#25D366]/40 backdrop-blur-md mb-6 shadow-[0_0_20px_rgba(37,211,102,0.15)]">
                <span class="w-2 h-2 rounded-full bg-[#25D366] animate-ping"></span>
                <span class="text-xs uppercase tracking-widest text-[#25D366] font-bold">Contacto Directo & Diagnóstico Gratuito</span>
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-[family-name:var(--font-space-grotesk)] font-bold mb-6 leading-tight text-white">
                Hablemos de tu <span class="text-gradient">Proyecto Digital</span>
            </h1>

            <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto mb-12 font-light leading-relaxed">
                Cuéntanos tus objetivos comerciales. En <strong class="text-white font-medium">SEMTIC</strong> analizamos tu caso de forma directa, diseñamos la estrategia exacta de <strong class="text-white font-medium">Landing Page, Google Ads, Meta Ads, SEO o Drones</strong> y te entregamos un presupuesto transparente en menos de 24 horas para empresas en la <strong class="text-[#2dd4bf] font-medium">Región de Valparaíso</strong> y la <strong class="text-[#2dd4bf] font-medium">Región Metropolitana de Santiago</strong>.
            </p>

            <!-- 3 Tarjetas Glassmorphism de Garantía en el Hero -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto text-left">
                <div class="group relative p-4 rounded-2xl bg-[#0a0a1a]/85 border border-white/10 hover:border-[#00f2ea]/50 backdrop-blur-xl flex items-center gap-3.5 transition-all duration-300 hover:-translate-y-1 shadow-[0_8px_30px_rgba(0,0,0,0.4)] overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-[#00f2ea] to-transparent opacity-60 group-hover:opacity-100 transition-opacity"></div>
                    <div class="w-14 h-14 rounded-xl overflow-hidden border border-[#00f2ea]/40 shadow-[0_0_15px_rgba(0,242,234,0.2)] shrink-0 bg-[#050511]">
                        <img src="/servicios-img/about-direct-contact.jpg" alt="Trato directo con ingenieros sin intermediarios" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="eager" />
                    </div>
                    <div>
                        <span class="text-[10px] uppercase tracking-wider font-bold text-[#00f2ea] block mb-0.5">Sin Vendedores</span>
                        <div class="text-white text-sm font-bold font-[family-name:var(--font-space-grotesk)] leading-tight">Trato 100% Directo</div>
                        <div class="text-gray-400 text-xs mt-0.5">Con quienes crean tu proyecto</div>
                    </div>
                </div>

                <div class="group relative p-4 rounded-2xl bg-[#0a0a1a]/85 border border-white/10 hover:border-[#25D366]/50 backdrop-blur-xl flex items-center gap-3.5 transition-all duration-300 hover:-translate-y-1 shadow-[0_8px_30px_rgba(0,0,0,0.4)] overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-[#25D366] to-transparent opacity-60 group-hover:opacity-100 transition-opacity"></div>
                    <div class="w-14 h-14 rounded-xl overflow-hidden border border-[#25D366]/40 shadow-[0_0_15px_rgba(37,211,102,0.2)] shrink-0 bg-[#050511]">
                        <img src="/servicios-img/faq-delivery-time.jpg" alt="Cotización y diagnóstico en menos de 24 horas" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="eager" />
                    </div>
                    <div>
                        <span class="text-[10px] uppercase tracking-wider font-bold text-[#25D366] block mb-0.5">Agilidad Real</span>
                        <div class="text-white text-sm font-bold font-[family-name:var(--font-space-grotesk)] leading-tight">Propuesta en &lt; 24h</div>
                        <div class="text-gray-400 text-xs mt-0.5">Plazos y costos definidos</div>
                    </div>
                </div>

                <div class="group relative p-4 rounded-2xl bg-[#0a0a1a]/85 border border-white/10 hover:border-[#2dd4bf]/50 backdrop-blur-xl flex items-center gap-3.5 transition-all duration-300 hover:-translate-y-1 shadow-[0_8px_30px_rgba(0,0,0,0.4)] overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-[#2dd4bf] to-transparent opacity-60 group-hover:opacity-100 transition-opacity"></div>
                    <div class="w-14 h-14 rounded-xl overflow-hidden border border-[#2dd4bf]/40 shadow-[0_0_15px_rgba(45,212,191,0.2)] shrink-0 bg-[#050511]">
                        <img src="/servicios-img/about-transparency.jpg" alt="Diagnóstico gratuito y transparente sin contratos de amarre" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="eager" />
                    </div>
                    <div>
                        <span class="text-[10px] uppercase tracking-wider font-bold text-[#2dd4bf] block mb-0.5">Cero Letra Chica</span>
                        <div class="text-white text-sm font-bold font-[family-name:var(--font-space-grotesk)] leading-tight">Diagnóstico Gratis</div>
                        <div class="text-gray-400 text-xs mt-0.5">Evaluación técnica sin costo</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: CONTACTO PRIORITARIO WHATSAPP + SELECTOR POR SERVICIO -->
    <section class="py-14 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <!-- Banner Principal WhatsApp -->
            <div class="p-8 md:p-12 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0b1c15] to-[#0a0a20] border border-[#25D366]/40 backdrop-blur-xl relative overflow-hidden shadow-2xl mb-14">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-1 bg-gradient-to-r from-transparent via-[#25D366] to-transparent"></div>
                
                <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
                    <div class="flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-6 max-w-2xl">
                        <div class="w-24 h-24 md:w-28 md:h-28 rounded-2xl overflow-hidden border border-[#25D366]/40 shadow-[0_0_30px_rgba(37,211,102,0.25)] shrink-0 bg-[#050511]">
                            <img src="/servicios-img/about-pyme-focus.jpg" alt="Atención directa por WhatsApp SEMTIC" class="w-full h-full object-cover" loading="lazy" />
                        </div>
                        <div>
                            <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30 mb-3 inline-flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-[#25D366] animate-ping"></span>
                                Canal Prioritario — Respuesta en Minutos
                            </span>
                            <h2 class="text-2xl md:text-4xl font-bold mb-3 text-white font-[family-name:var(--font-space-grotesk)]">
                                Escríbenos Directamente por WhatsApp
                            </h2>
                            <p class="text-gray-300 text-sm md:text-base font-light leading-relaxed">
                                Inicia un chat directo con nuestro equipo técnico. Cuéntanos qué necesitas implementar y te orientaremos al instante con la alternativa más rentable para tu negocio.
                            </p>
                        </div>
                    </div>

                    <div class="shrink-0">
                        <a href="https://wa.me/56988169404?text=Hola%20SEMTIC!%20Quiero%20agendar%20una%20reuni%C3%B3n%20o%20recibir%20asesor%C3%ADa%20para%20mi%20proyecto" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-5 bg-gradient-to-r from-[#25D366] to-[#2dd4bf] rounded-full text-[#050511] font-extrabold text-sm md:text-base tracking-wide shadow-lg hover:shadow-[0_0_40px_rgba(37,211,102,0.6)] transition-all duration-300 transform hover:-translate-y-1 gap-3 uppercase whitespace-nowrap">
                            <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                            Abrir Chat de WhatsApp
                        </a>
                    </div>
                </div>
            </div>

            <!-- Selector Rápido por Tipo de Proyecto -->
            <div class="text-center mb-10">
                <span class="text-xs uppercase tracking-widest text-[#2dd4bf] font-bold block mb-2">Atención Especializada</span>
                <h2 class="text-2xl md:text-4xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-3">
                    ¿Sobre qué servicio <span class="text-gradient">quieres cotizar hoy</span>?
                </h2>
                <p class="text-gray-400 text-sm md:text-base max-w-2xl mx-auto font-light">
                    Selecciona el área de tu proyecto para iniciar una conversación en WhatsApp con el mensaje preconfigurado.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {quickWhatsappTopics.map((topic) => (
                    <a
                        href={`https://wa.me/56988169404?text=${topic.waText}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group relative p-6 rounded-3xl bg-[#0a0a1a]/85 border border-white/10 hover:border-[#2dd4bf]/50 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_12px_35px_rgba(45,212,191,0.12)] flex flex-col sm:flex-row items-start sm:items-center gap-5 overflow-hidden"
                    >
                        <div class="w-24 h-24 md:w-28 md:h-28 rounded-2xl overflow-hidden border border-white/15 group-hover:border-[#2dd4bf]/50 shrink-0 bg-[#050511] shadow-[0_0_20px_rgba(0,0,0,0.5)]">
                            <img
                                src={topic.image}
                                alt={topic.title}
                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                loading="lazy"
                            />
                        </div>
                        <div class="flex-1">
                            <div class="flex flex-wrap items-center gap-2 mb-1.5">
                                <span
                                    class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border"
                                    style={`color: ${topic.color}; border-color: ${topic.color}40; background-color: ${topic.color}12;`}
                                >
                                    {topic.badge}
                                </span>
                                <span class="text-[11px] text-gray-400 font-medium">{topic.subtitle}</span>
                            </div>
                            <h3 class="text-lg md:text-xl font-bold text-white font-[family-name:var(--font-space-grotesk)] group-hover:text-[#00f2ea] transition-colors mb-1.5">
                                {topic.title}
                            </h3>
                            <p class="text-gray-400 text-xs md:text-sm font-light leading-relaxed mb-3">
                                {topic.desc}
                            </p>
                            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[#25D366] group-hover:translate-x-1 transition-transform">
                                Cotizar este servicio por WhatsApp →
                            </span>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3: PROCESO DE DIAGNÓSTICO EN 3 PASOS CON IMÁGENES 3D -->
    <section class="py-20 relative bg-gradient-to-b from-transparent via-[#0a0a20]/60 to-transparent" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center mb-14">
                <span class="text-xs uppercase tracking-widest text-[#00f2ea] font-bold block mb-2">Proceso Simple y Transparente</span>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    ¿Qué ocurre después de <span class="text-gradient">contactarnos</span>?
                </h2>
                <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto font-light">
                    Respetamos tu tiempo. Así pasamos de tu primera consulta a un plan de acción concreto en menos de 24 horas.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {diagnosticSteps.map((item) => (
                    <div class="group relative rounded-3xl bg-[#0a0a1a]/85 border border-white/10 hover:border-[#2dd4bf]/50 p-6 md:p-7 backdrop-blur-xl transition-all duration-300 hover:-translate-y-1.5 shadow-xl flex flex-col justify-between overflow-hidden">
                        <div>
                            <div class="relative h-44 w-full rounded-2xl overflow-hidden mb-6 border border-white/10 bg-[#050511]">
                                <img
                                    src={item.image}
                                    alt={item.title}
                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                    loading="lazy"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a] via-transparent to-transparent opacity-65"></div>
                                <span
                                    class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-extrabold font-[family-name:var(--font-space-grotesk)] bg-[#050511]/90 border backdrop-blur-md"
                                    style={`color: ${item.color}; border-color: ${item.color}50;`}
                                >
                                    PASO {item.step}
                                </span>
                            </div>

                            <h3 class="text-xl font-bold text-white font-[family-name:var(--font-space-grotesk)] mb-3 group-hover:text-[#00f2ea] transition-colors">
                                {item.title}
                            </h3>
                            <p class="text-gray-300 text-sm font-light leading-relaxed mb-5">
                                {item.desc}
                            </p>
                        </div>

                        <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                            <span class="text-xs font-semibold text-[#2dd4bf] inline-flex items-center gap-1.5">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#2dd4bf]"></span>
                                {item.tag}
                            </span>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- SECCIÓN 4: CANALES DE CONTACTO DIRECTO (3 Tarjetas Glassmórficas) -->
    <section class="py-16 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center mb-14">
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    Todos Nuestros Canales de <span class="text-gradient">Comunicación</span>
                </h2>
                <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto font-light">
                    Elige la vía directa que prefieras para conversar con nuestro equipo.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Tarjeta WhatsApp -->
                <a href="https://wa.me/56988169404?text=Hola%20SEMTIC!%20Quisiera%20hacer%20una%20consulta%20por%20sus%20servicios." target="_blank" rel="noopener noreferrer" class="group relative p-8 rounded-3xl bg-[#0a0a1a]/85 border border-white/10 backdrop-blur-xl hover:border-[#25D366]/50 transition-all duration-500 hover:-translate-y-1.5 shadow-xl text-center flex flex-col items-center justify-between overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-[#25D366] to-transparent opacity-50 group-hover:opacity-100"></div>
                    <div>
                        <div class="w-16 h-16 mb-6 mx-auto rounded-2xl bg-[#25D366]/10 border border-[#25D366]/30 flex items-center justify-center text-[#25D366] group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(37,211,102,0.15)]">
