    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={CONFIG.seo.title} />
    <meta name="twitter:description" content={CONFIG.seo.description} />
    <meta name="twitter:image" content={CONFIG.seo.ogImage} />

    <!-- Preconnect & Fuentes Optimizadas -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Datos Estructurados Schema.org con FAQ de esta Landing -->
    <SchemaOrgJsonLd customFaqs={faqs} />

    <style>
      /* Animación nativa limpia para acordeón <details> sin dependencias JS */
      details > summary {
        list-style: none;
      }
      details > summary::-webkit-details-marker {
        display: none;
      }
      details[open] summary ~ * {
        animation: fadeInAccordion 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes fadeInAccordion {
        from {
          opacity: 0;
          transform: translateY(-6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Animaciones de entrada Hero y Scroll Reveal */
      @keyframes heroFadeUp {
        from {
          opacity: 0;
          transform: translateY(22px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .hero-stagger-1 { animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
      .hero-stagger-2 { animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.16s both; }
      .hero-stagger-3 { animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.28s both; }
      .hero-stagger-4 { animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.40s both; }
      .hero-stagger-5 { animation: heroFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.52s both; }

      .reveal-up {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .reveal-up.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* Flotación suave para ilustraciones 3D */
      @keyframes floatSlow {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-8px); }
      }
      .float-slow {
        animation: floatSlow 5.5s ease-in-out infinite;
      }

      /* Degradado de texto animado */
      @keyframes gradientFlow {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      .text-gradient-vibrant {
        background: linear-gradient(90deg, #00f2ea, #2dd4bf, #3b82f6, #818cf8, #00f2ea);
        background-size: 220% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: gradientFlow 7s ease infinite;
      }

      /* Respetar preferencia de movimiento reducido */
      @media (prefers-reduced-motion: reduce) {
        .hero-stagger-1, .hero-stagger-2, .hero-stagger-3, .hero-stagger-4, .hero-stagger-5,
        .float-slow, .text-gradient-vibrant {
          animation: none !important;
        }
        .reveal-up {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>

