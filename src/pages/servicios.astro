    <!-- SCRIPT DEL CANVAS DEL TOROIDE 3D + SCROLL REVEAL -->
    <script>
      function initTorusCanvas() {
        const canvas = document.getElementById('torusCanvas') as HTMLCanvasElement | null;
        const heroSection = document.getElementById('servicios-hero');
        if (!canvas || !heroSection) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        let width = 0, height = 0;
        let particles: Particle[] = [];
        let animationFrameId = 0;
        let isVisible = false;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const timeMultiplier = prefersReducedMotion ? 0.05 : 1;
        const speedMultiplier = prefersReducedMotion ? 0 : 1;

        const colors = ['#2dd4bf', '#3b82f6', '#4f46e5', '#818cf8', '#00f2ea'];

        function resize() {
          const rect = heroSection!.getBoundingClientRect();
          const maxDpr = window.innerWidth < 768 ? 1.5 : 2;
          const dpr = Math.min(window.devicePixelRatio || 1, maxDpr);
          width = rect.width || window.innerWidth;
          height = rect.height || window.innerHeight;

          canvas!.width = width * dpr;
          canvas!.height = height * dpr;
          canvas!.style.width = width + 'px';
          canvas!.style.height = height + 'px';

          ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        class Particle {
          u = 0;
          v = 0;
          R = 0;
          r = 0;
          color = '';
          size = 0;
          speedU = 0;
          speedV = 0;
          x2d = 0;
          y2d = 0;
          alpha = 0;

          constructor() {
            this.reset();
          }

          reset() {
            this.u = Math.random() * Math.PI * 2;
            this.v = Math.random() * Math.PI * 2;
            this.R = 200 + Math.random() * 50;
            this.r = 80 + Math.random() * 20;
            this.color = colors[Math.floor(Math.random() * colors.length)];
            this.size = Math.random() * 1.6 + 0.3;
            this.speedU = (0.002 + Math.random() * 0.005) * speedMultiplier;
            this.speedV = (0.001 + Math.random() * 0.003) * speedMultiplier;
          }

          update(timeInSecs: number) {
            this.u += this.speedU;
            this.v += this.speedV;

            let x3d = (this.R + this.r * Math.cos(this.u)) * Math.cos(this.v);
            let y3d = (this.R + this.r * Math.cos(this.u)) * Math.sin(this.v);
            let z3d = this.r * Math.sin(this.u);

            const time = timeInSecs * 0.3 * timeMultiplier;

            let yTemp = y3d * Math.cos(time) - z3d * Math.sin(time);
            let zTemp = y3d * Math.sin(time) + z3d * Math.cos(time);
            y3d = yTemp;
            z3d = zTemp;

            let xTemp = x3d * Math.cos(time * 0.5) - z3d * Math.sin(time * 0.5);
            z3d = x3d * Math.sin(time * 0.5) + z3d * Math.cos(time * 0.5);
            x3d = xTemp;

            const scale = 800 / (800 + z3d);
            this.x2d = width / 2 + x3d * scale;
            this.y2d = height / 2 + y3d * scale;
            this.alpha = scale;
          }

          draw() {
            if (!ctx) return;
            ctx.beginPath();
            ctx.arc(this.x2d, this.y2d, this.size, 0, Math.PI * 2);
            ctx.fillStyle = this.color;
            ctx.globalAlpha = Math.max(0.12, this.alpha - 0.45);
            ctx.fill();
            ctx.globalAlpha = 1;
          }
        }

        const particleCount = window.innerWidth < 768 ? 300 : window.innerWidth < 1024 ? 500 : 800;
        for (let i = 0; i < particleCount; i++) {
          particles.push(new Particle());
        }

        let startTime = Date.now();
        let pauseTimeOffset = 0;
        let lastPauseTime = 0;

        function animate() {
          if (!isVisible || !ctx) return;
          ctx.fillStyle = 'rgba(5, 5, 17, 0.22)';
          ctx.fillRect(0, 0, width, height);

          const timeInSecs = (Date.now() - startTime - pauseTimeOffset) / 1000;
          particles.forEach((p) => {
            p.update(timeInSecs);
            p.draw();
          });

          animationFrameId = requestAnimationFrame(animate);
        }

        let resizeTimeout: any;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimeout);
          resizeTimeout = setTimeout(resize, 150);
        });
        resize();

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                if (!isVisible) {
                  isVisible = true;
                  if (lastPauseTime > 0) {
                    pauseTimeOffset += Date.now() - lastPauseTime;
                  }
                  animate();
                }
              } else {
                isVisible = false;
                cancelAnimationFrame(animationFrameId);
                lastPauseTime = Date.now();
              }
            });
          },
          { threshold: 0 }
        );

        observer.observe(heroSection);
      }

      function initScrollReveal() {
        const elements = document.querySelectorAll('.reveal-up');
        if (!('IntersectionObserver' in window)) {
          elements.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const revealObserver = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        elements.forEach((el) => revealObserver.observe(el));
      }

      function initBgParticles() {
        const bgCanvas = document.getElementById('bgCanvas') as HTMLCanvasElement | null;
        if (!bgCanvas) return;
        const bgCtx = bgCanvas.getContext('2d');
        if (!bgCtx) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let bgWidth = 0, bgHeight = 0;

        function resizeBg() {
          bgWidth = bgCanvas!.width = window.innerWidth;
          bgHeight = bgCanvas!.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeBg);
        resizeBg();

        class BgParticle {
          x: number;
          y: number;
          vx: number;
          vy: number;
          size: number;
          color: string;

          constructor() {
            this.x = Math.random() * bgWidth;
            this.y = Math.random() * bgHeight;
            this.vx = (Math.random() - 0.5) * 0.5;
            this.vy = (Math.random() - 0.5) * 0.5;
            this.size = Math.random() * 2.5;
            this.color = Math.random() > 0.5 ? '#00f2ea' : '#b026ff';
          }

          update() {
            if (prefersReducedMotion) return;
            this.x += this.vx;
            this.y += this.vy;

            if (this.x < 0) this.x = bgWidth;
            if (this.x > bgWidth) this.x = 0;
            if (this.y < 0) this.y = bgHeight;
            if (this.y > bgHeight) this.y = 0;
          }

          draw() {
            if (!bgCtx) return;
            bgCtx.beginPath();
            bgCtx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            bgCtx.fillStyle = this.color;
            bgCtx.globalAlpha = 0.7;
            bgCtx.fill();
          }
        }

        const count = window.innerWidth < 768 ? 45 : 85;
        const bgParticles: BgParticle[] = [];
        for (let i = 0; i < count; i++) {
          bgParticles.push(new BgParticle());
        }

        function animateBg() {
          if (!bgCtx) return;
          bgCtx.clearRect(0, 0, bgWidth, bgHeight);

          for (let i = 0; i < bgParticles.length; i++) {
            bgParticles[i].update();
            bgParticles[i].draw();

            for (let j = i; j < bgParticles.length; j++) {
              const dx = bgParticles[i].x - bgParticles[j].x;
              const dy = bgParticles[i].y - bgParticles[j].y;
              const distance = Math.sqrt(dx * dx + dy * dy);

              if (distance < 160) {
                bgCtx.beginPath();
                bgCtx.strokeStyle = bgParticles[i].color;
                bgCtx.globalAlpha = 0.22 - (distance / 160) * 0.22;
                bgCtx.lineWidth = 0.9;
                bgCtx.moveTo(bgParticles[i].x, bgParticles[i].y);
                bgCtx.lineTo(bgParticles[j].x, bgParticles[j].y);
                bgCtx.stroke();
              }
            }
          }
          if (!prefersReducedMotion) {
            requestAnimationFrame(animateBg);
          }
        }
        animateBg();
      }

      function bootServiciosAnimations() {
        initScrollReveal();
        initBgParticles();
        initTorusCanvas();
      }

      if (typeof window !== 'undefined') {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bootServiciosAnimations);
        } else {
          bootServiciosAnimations();
        }
      }
    </script>
  </body>
</html>
