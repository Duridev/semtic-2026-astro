const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="es" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{CONFIG.seo.title}</title>
    <meta name="description" content={CONFIG.seo.description} />
    <meta name="author" content="SEMTIC Agencia Digital" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#020617" />

    <!-- Canonical -->
    <link rel="canonical" href={CONFIG.seo.canonicalUrl} />
    <link rel="icon" type="image/webp" href="/semtic-favicon.webp" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={CONFIG.seo.canonicalUrl} />
    <meta property="og:title" content={CONFIG.seo.title} />
    <meta property="og:description" content={CONFIG.seo.description} />
    <meta property="og:image" content={CONFIG.seo.ogImage} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preconnect & Fuentes Optimizadas -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <!-- Datos Estructurados Schema.org -->
    <SchemaOrgJsonLd />

    <style>
      /* Animación nativa limpia para acordeón <details> sin dependencias JS */
      details > summary {
        list-style: none;
      }
      details > summary::-webkit-details-marker {
        display: none;
      }
      details[open] summary ~ * {
        animation: fadeInAccordion 0.25s ease-out;
      }
      @keyframes fadeInAccordion {
        from {
          opacity: 0;
          transform: translateY(-4px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>
  </head>

  <body class="bg-slate-950 text-slate-100 antialiased selection:bg-cyan-400 selection:text-slate-950 overflow-x-hidden">
    <!-- Efectos de luz ambiental estáticos (Puro CSS = 0 impacto en CPU/TBT) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-40 left-1/4 w-[28rem] h-[28rem] bg-blue-600/15 rounded-full blur-[130px]"></div>
      <div class="absolute top-1/3 -right-32 w-[26rem] h-[26rem] bg-cyan-500/10 rounded-full blur-[130px]"></div>
      <div class="absolute bottom-0 left-1/3 w-[24rem] h-[24rem] bg-emerald-500/10 rounded-full blur-[140px]"></div>
    </div>

    <!-- =====================================================================
         1. HEADER MINIMALISTA (SIN ENLACES DE ESCAPE)
         ===================================================================== -->
    <header class="sticky top-0 z-50 w-full bg-slate-950/85 backdrop-blur-md border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        <!-- Marca SEMTIC + Badge de Tecnología/Innovación (Sin link externo de fuga) -->
        <div class="flex items-center gap-3 sm:gap-4">
          <a href="#top" class="flex items-center gap-2.5 focus:outline-none group" aria-label="SEMTIC Inicio">
            <img
              src="/logo-semtic.png"
              alt="SEMTIC Agencia Digital"
              width="140"
              height="36"
              class="h-7 sm:h-9 w-auto object-contain"
              loading="eager"
              decoding="async"
            />
          </a>
          <span class="hidden md:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-slate-900/90 text-cyan-400 border border-cyan-500/30 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
            Astro Tech &amp; Performance Ads
          </span>
        </div>

        <!-- Botón directo de acción en esquina derecha -->
        <a
          href={getWhatsAppUrl(CONFIG.whatsappMessages.header)}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-xs sm:text-sm tracking-wide shadow-lg shadow-emerald-500/20 hover:shadow-emerald-500/40 transition-all duration-200 hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-950"
        >
          <svg class="w-4 h-4 sm:w-5 sm:h-5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
          </svg>
          <span>Hablemos por WhatsApp</span>
        </a>
      </div>
    </header>

    <main id="top" class="relative z-10">
      <!-- =====================================================================
           2. HERO SECTION (PRIMER PANTALLAZO DE ALTO IMPACTO)
           ===================================================================== -->
      <section class="relative pt-16 pb-20 md:pt-24 md:pb-28 overflow-hidden border-b border-white/10">
        <!-- Imagen de fondo del Hero con capa de color encima para contraste óptimo -->
        <div class="absolute inset-0 z-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
          <img
            src="/servicios-img/hero-bg.jpg"
            alt=""
            width="1920"
            height="1080"
            class="w-full h-full object-cover object-center opacity-85"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <!-- Capa de color semitransparente encima para mantener legibilidad sin ocultar la imagen -->
          <div class="absolute inset-0 bg-blue-950/25"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-slate-950/55 via-slate-950/45 to-slate-950/90"></div>
        </div>

        <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <!-- Badge Superior -->
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/80 border border-white/10 backdrop-blur-sm mb-8 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
            <span class="text-xs sm:text-sm font-semibold tracking-wide text-cyan-400 uppercase">
              Páginas Web Ultrarrápidas &amp; Campañas de Adquisición
            </span>
          </div>

          <!-- H1 con foco en beneficio comercial -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold font-[family-name:var(--font-space-grotesk)] tracking-tight leading-[1.12] mb-6 bg-gradient-to-r from-white via-slate-200 to-cyan-400 bg-clip-text text-transparent">
            Sitios web que cargan al instante y campañas que generan prospectos reales para tu negocio
          </h1>

          <!-- Subtítulo -->
          <p class="text-base sm:text-lg md:text-xl text-slate-300 max-w-3xl mx-auto mb-10 leading-relaxed font-normal">
            Diseñamos en <strong class="text-white font-semibold">Astro</strong> con la velocidad que Google exige y estructuramos tu publicidad para que recibas cotizaciones directas a tu WhatsApp o correo, sin depender de plantillas lentas ni código inflado.
          </p>

          <!-- Dos Call-To-Action (CTAs) -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
            <!-- Botón Primario: WhatsApp -->
            <a
              href={getWhatsAppUrl(CONFIG.whatsappMessages.hero)}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-7 py-4 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-base sm:text-lg shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 transition-all duration-200 hover:-translate-y-0.5"
            >
              <svg class="w-6 h-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
              </svg>
              <span>Solicitar Asesoría por WhatsApp</span>
            </a>

            <!-- Botón Secundario: Scroll suave a soluciones -->
            <a
              href="#soluciones"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800/90 text-white font-semibold text-base sm:text-lg border border-white/10 hover:border-cyan-400/40 backdrop-blur-sm transition-all duration-200"
            >
              <span>Ver cómo trabajamos</span>
              <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
          </div>

          <!-- Micro-credenciales bajo los botones -->
          <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs sm:text-sm text-slate-300">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>Carga en menos de 1 segundo</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>Configuración de analítica incluida</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              <span>Atención directa y personalizada</span>
            </div>
          </div>
        </div>
      </section>

      <!-- =====================================================================
           3. PROBLEMA VS SOLUCIÓN (LA VENTAJA DE NO USAR SITIOS LENTOS)
           ===================================================================== -->
      <section id="soluciones" class="py-20 bg-slate-900/40 border-y border-white/10 scroll-mt-20">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center max-w-3xl mx-auto mb-14">
            <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-cyan-400 block mb-2">
              Rendimiento vs Rebote
            </span>
            <h2 class="text-2xl sm:text-4xl font-bold font-[family-name:var(--font-space-grotesk)] bg-gradient-to-r from-white via-slate-200 to-cyan-400 bg-clip-text text-transparent mb-4">
              ¿Por qué la mayoría de las campañas pierden dinero antes de que el cliente lea tu oferta?
            </h2>
            <p class="text-slate-300 text-base sm:text-lg">
              Cuando pagas por un clic en Google Ads, cada segundo de carga decide si ganas una cotización o si le regalas el cliente a tu competencia.
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
            <!-- Columna 1: La web tradicional lenta -->
            <div class="p-7 sm:p-9 rounded-2xl bg-slate-900/60 border border-rose-500/20 backdrop-blur-sm flex flex-col justify-between relative overflow-hidden group">
