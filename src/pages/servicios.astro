              >
                <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer select-none text-left font-semibold text-base sm:text-lg text-white hover:text-cyan-400 transition-colors">
                  <span>{faq.question}</span>
                  <span class="w-8 h-8 rounded-full bg-slate-800 border border-white/10 flex items-center justify-center text-cyan-400 shrink-0 transition-transform duration-200 group-open:rotate-180">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="px-6 pb-6 pt-4 border-t border-white/5 flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-5">
                  <img
                    src={faq.image}
                    alt={faq.imageAlt}
                    width="96"
                    height="96"
                    class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl object-cover shrink-0 border border-cyan-400/30 bg-slate-950 shadow-md shadow-cyan-500/10"
                    loading="lazy"
                    decoding="async"
                  />
                  <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                    {faq.answer}
                  </p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- =====================================================================
           8. CONTACTO DIRECTO POR WHATSAPP & CTA DE CIERRE
           ===================================================================== -->
      <section id="contacto-final" class="py-20 sm:py-24 scroll-mt-16">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="p-7 sm:p-10 lg:p-12 rounded-3xl bg-slate-900/70 border border-emerald-500/30 backdrop-blur-sm shadow-2xl shadow-emerald-500/5 relative overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-emerald-500 via-cyan-400 to-blue-600"></div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
              <!-- Columna Izquierda: Imagen de acompañamiento (Captación de cotizaciones en WhatsApp) -->
              <div class="lg:col-span-5">
                <div class="relative rounded-2xl overflow-hidden border border-emerald-500/30 bg-slate-950 shadow-xl group">
                  <img
                    src="/servicios-img/cta-whatsapp-leads.jpg"
                    alt="Cotizaciones y prospectos comerciales llegando en tiempo real a WhatsApp"
                    width="600"
                    height="450"
                    class="w-full h-64 sm:h-72 lg:h-80 object-cover object-center group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent"></div>
                  <div class="absolute bottom-4 left-4 right-4 p-3 rounded-xl bg-slate-950/90 border border-emerald-500/30 backdrop-blur-md flex items-center gap-3">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping shrink-0"></span>
                    <span class="text-xs font-medium text-slate-200">
                      Flujo continuo de prospectos directo a tu celular
                    </span>
                  </div>
                </div>
              </div>

              <!-- Columna Derecha: Contenido y CTA Directo a WhatsApp -->
              <div class="lg:col-span-7 text-left space-y-6">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 uppercase tracking-wider">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                  Atención Inmediata • Diagnóstico Comercial Sin Costo
                </div>

                <h2 class="text-2xl sm:text-4xl font-bold font-[family-name:var(--font-space-grotesk)] bg-gradient-to-r from-white via-slate-200 to-cyan-400 bg-clip-text text-transparent leading-tight">
                  ¿Listo para recibir cotizaciones reales en tu negocio?
                </h2>

                <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
                  Si prefieres atención inmediata y sin formularios largos, escríbenos directamente a nuestro WhatsApp comercial. Analizaremos tu rubro y te propondremos una estrategia clara de Landing Page en Astro + Google Ads.
                </p>

                <div class="pt-1">
                  <a
                    href={getWhatsAppUrl(CONFIG.whatsappMessages.closing)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-base sm:text-lg shadow-xl shadow-emerald-500/25 hover:shadow-emerald-500/40 transition-all duration-200 hover:-translate-y-0.5"
                  >
                    <svg class="w-6 h-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                    </svg>
                    <span>Hablar por WhatsApp ({CONFIG.whatsappDisplay})</span>
                  </a>
                </div>

                <div class="pt-4 border-t border-white/10 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs sm:text-sm text-slate-400">
                  <span>⚡ Respuesta directa con especialista</span>
                  <span>•</span>
                  <span>📍 Atención en todo Chile</span>
                  <span>•</span>
                  <span>
                    Correo:{" "}
                    <a href={`mailto:${CONFIG.contactEmail}`} class="text-cyan-400 hover:underline font-medium">
                      {CONFIG.contactEmail}
                    </a>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- =====================================================================
         9. FOOTER MÍNIMO + MODAL DE PRIVACIDAD + BOTÓN FLOTANTE DE WHATSAPP
         ===================================================================== -->
    <footer class="relative z-10 border-t border-white/10 bg-slate-950 py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm text-slate-400">
        <div class="flex items-center gap-3">
          <img
            src="/logo-semtic.png"
            alt="SEMTIC"
            width="100"
            height="26"
            class="h-5 w-auto opacity-80"
            loading="lazy"
            decoding="async"
          />
          <span>Copyright © {currentYear} SEMTIC. Todos los derechos reservados.</span>
        </div>

        <div class="flex items-center gap-6">
          <button
            type="button"
            onclick="document.getElementById('privacy-modal').showModal()"
            class="text-slate-400 hover:text-cyan-400 underline-offset-4 hover:underline transition-colors cursor-pointer"
          >
            Políticas de Privacidad y Términos
          </button>
        </div>
      </div>
    </footer>

    <!-- Modal nativo <dialog> para Políticas de Privacidad (Evita que el usuario abandone la Landing) -->
    <dialog
      id="privacy-modal"
      class="m-auto max-w-xl w-[92%] rounded-2xl bg-slate-900 text-slate-200 border border-white/15 p-6 sm:p-8 shadow-2xl backdrop:bg-slate-950/80 backdrop:backdrop-blur-sm"
    >
      <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
        <h3 class="text-lg font-bold text-white font-[family-name:var(--font-space-grotesk)]">
          Política de Privacidad y Uso de Datos
        </h3>
        <button
          type="button"
          onclick="document.getElementById('privacy-modal').close()"
          class="text-slate-400 hover:text-white p-1"
          aria-label="Cerrar ventana"
        >
          ✕
        </button>
      </div>
      <div class="space-y-3 text-xs sm:text-sm text-slate-300 leading-relaxed max-h-[60vh] overflow-y-auto pr-1">
        <p>
          <strong>1. Uso de la información:</strong> Los datos compartidos a través de nuestro canal de WhatsApp o correo electrónico se utilizan única y exclusivamente para responder a tu solicitud de cotización o asesoría comercial en SEMTIC.
        </p>
        <p>
          <strong>2. Confidencialidad:</strong> SEMTIC no vende, cede ni comparte tus datos de contacto con terceros bajo ninguna circunstancia.
        </p>
        <p>
          <strong>3. Medición y Cookies:</strong> Este sitio utiliza herramientas de analítica (como Google Analytics y etiquetas de conversión de Google Ads) para medir el rendimiento estadístico de nuestras campañas publicitarias de forma anónima.
        </p>
        <p>
          <strong>4. Contacto responsable:</strong> Para solicitar la eliminación o modificación de tus datos, puedes escribir directamente a <a href={`mailto:${CONFIG.contactEmail}`} class="text-cyan-400 underline">{CONFIG.contactEmail}</a>.
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-white/10 text-right">
        <button
          type="button"
          onclick="document.getElementById('privacy-modal').close()"
          class="px-5 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs sm:text-sm font-semibold cursor-pointer"
        >
          Entendido
        </button>
      </div>
    </dialog>

    <!-- Botón flotante fijo en esquina inferior derecha (WhatsApp Oficial Verde Esmeralda) -->
    <a
      href={getWhatsAppUrl(CONFIG.whatsappMessages.floating)}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
      class="fixed bottom-5 right-5 sm:bottom-7 sm:right-7 z-50 flex items-center gap-2.5 p-3.5 sm:px-5 sm:py-3.5 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-sm shadow-2xl shadow-emerald-500/40 hover:scale-105 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-emerald-300"
    >
      <svg class="w-7 h-7 sm:w-6 sm:h-6 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
      </svg>
      <span class="hidden sm:inline">WhatsApp Directo</span>
    </a>
  </body>
</html>
