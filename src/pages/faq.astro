---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const faqs = [
    {
        category: "Desarrollo Web",
        color: "#00f2ea",
        question: "¿Cuánto demora tener mi página web lista?",
        answer: "Depende de la complejidad. Una Landing Page o sitio corporativo estándar toma entre 7 y 15 días hábiles; un e-commerce completo entre 15 y 30 días. Realizamos un diagnóstico gratuito inicial para calendarizar con precisión."
    },
    {
        category: "Desarrollo Web",
        color: "#00f2ea",
        question: "¿Qué incluye el desarrollo de mi sitio web?",
        answer: "Incluye diseño UX/UI a medida, maquetación responsive para móviles, integración con WhatsApp y formularios, seguridad SSL, optimización de velocidad de carga, SEO inicial y panel autoadministrable."
    },
    {
        category: "SEO & Ads",
        color: "#2dd4bf",
        question: "¿Qué es SEO y por qué mi empresa lo necesita?",
        answer: "El SEO es la optimización técnica y de contenido para buscadores. Permite que tu negocio aparezca orgánicamente en los primeros lugares de Google cuando tus clientes buscan lo que vendes en su zona."
    },
    {
        category: "SEO & Ads",
        color: "#39ff14",
        question: "¿Qué diferencia hay entre Google Ads y Meta Ads?",
        answer: "Google Ads capta la intención directa de personas que buscan activamente tu servicio. Meta Ads (Instagram y Facebook) genera interés visual interrumpiendo el scroll con anuncios atractivos para crear demanda."
    },
    {
        category: "SEO & Ads",
        color: "#2dd4bf",
        question: "¿Puedo combinar SEO con campañas pagadas en Google y Meta?",
        answer: "¡Totalmente! Es la estrategia ideal: Google y Meta Ads te generan prospectos inmediatos mientras el trabajo de SEO va construyendo posicionamiento orgánico sostenible en el tiempo."
    },
    {
        category: "Redes Sociales",
        color: "#4f46e5",
        question: "¿Qué incluye el servicio de Community Manager y Redes Sociales?",
        answer: "Incluye planificación de línea gráfica, redacción de copys profesionales, diseño de piezas para feed e historias, calendario editorial mensual, programación estratégica y análisis de métricas clave."
    },
    {
        category: "Redes Sociales",
        color: "#4f46e5",
        question: "¿Tienen planes para emprendedores y pymes en crecimiento?",
        answer: "Sí. Ofrecemos planes flexibles ajustados a etapas iniciales, con landing pages livianas y paquetes de manejo de redes esenciales que te ayudan a crecer sin sobrecostos."
    },
    {
        category: "Servicios con Dron",
        color: "#3b82f6",
        question: "¿En qué zonas prestan servicio de grabación e inspección con Dron?",
        answer: "Tenemos cobertura preferente en toda la Región de Valparaíso (Viña del Mar, Valparaíso, Concón, Quilpué, Limache) y la Región Metropolitana (Santiago), con disponibilidad de traslado a cualquier región de Chile."
    },
    {
        category: "Servicios con Dron",
        color: "#3b82f6",
        question: "¿Sus operaciones con Dron cuentan con normativa DGAC?",
        answer: "Sí, todos nuestros vuelos comerciales son ejecutados bajo la normativa vigente de la Dirección General de Aeronáutica Civil (DGAC), previa planificación de espacio aéreo y protocolos de seguridad."
    },
    {
        category: "Desarrollo Web",
        color: "#00f2ea",
        question: "¿Puedo usar mi propio dominio (.cl) y hosting?",
        answer: "Por supuesto. Si ya posees dominio en Nic.cl y servicio de hosting, nos encargamos de realizar las configuraciones DNS. Si no lo tienes, te guiamos en la compra sin costo adicional."
    },
    {
        category: "General",
        color: "#2dd4bf",
        question: "¿Cómo es el proceso para agendar un diagnóstico o cotización?",
        answer: "Es muy fácil: escríbenos directamente por WhatsApp o mediante nuestro formulario de contacto. Analizamos tu proyecto, respondemos tus dudas y te entregamos un presupuesto transparente en menos de 24 horas."
    }
];
---

<Layout 
    title="Preguntas Frecuentes | SEMTIC Agencia Digital" 
    description="Resuelve tus dudas sobre desarrollo web, SEO, campañas de Google y Meta Ads y servicios de dron en Chile."
    image="https://semtic.cl/og-faq.png">

    <!-- SECCIÓN 1: HERO -->
    <section class="relative min-h-[60vh] flex items-center justify-center pt-32 pb-20 overflow-hidden" style="z-index: 10;">
        <!-- Resplandores neón -->
        <div class="absolute top-1/4 left-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#4f46e5] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#2dd4bf] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse" style="animation-delay: 2s;"></div>

        <div class="relative z-10 text-center px-4 max-w-4xl mx-auto hero-container">
            <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-[#2dd4bf]/40 backdrop-blur-md mb-6">
                <span class="w-2 h-2 rounded-full bg-[#2dd4bf] animate-ping"></span>
                <span class="text-xs uppercase tracking-widest text-[#2dd4bf] font-bold">💡 Centro de Respuestas & Soporte</span>
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-[family-name:var(--font-space-grotesk)] font-bold mb-6 leading-tight text-white">
                Preguntas <span class="text-gradient">Frecuentes</span>
            </h1>

            <p class="text-gray-300 text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed">
                Encuentra respuestas claras y rápidas sobre el desarrollo de páginas web, SEO, campañas publicitarias y servicios con drones.
            </p>
        </div>
    </section>

    <!-- SECCIÓN 2: LISTADO DE FAQ INTERACTIVO -->
    <section class="py-16 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-4xl">
            <div class="space-y-4">
                {faqs.map((faq, index) => (
                    <details class="group rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl transition-all duration-300 open:border-[#2dd4bf]/50 open:bg-[#0a0a1a]/95 shadow-xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex justify-between items-center p-6 md:p-8 cursor-pointer select-none">
                            <div class="flex items-center gap-3 pr-4">
                                <span class="px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white/5 border border-white/10 text-[#2dd4bf] shrink-0">
                                    {faq.category}
                                </span>
                                <h3 class="text-lg md:text-xl font-bold text-white font-[family-name:var(--font-space-grotesk)] group-open:text-[#00f2ea] transition-colors leading-snug">
                                    {faq.question}
                                </h3>
                            </div>
                            <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-[#2dd4bf] group-open:rotate-180 group-open:bg-[#2dd4bf] group-open:text-[#050511] transition-all duration-300 shrink-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                            </div>
                        </summary>
                        <div class="px-6 md:px-8 pb-8 text-gray-300 text-sm md:text-base leading-relaxed font-light border-t border-white/5 pt-4">
                            {faq.answer}
                        </div>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3: BANNER AL BLOG -->
    <section class="py-10 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-4xl">
            <div class="p-8 md:p-10 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0d123b] to-[#0a0a20] border border-[#2dd4bf]/40 backdrop-blur-xl relative overflow-hidden shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="max-w-xl">
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[#2dd4bf]/10 border border-[#2dd4bf]/30 text-[#2dd4bf] mb-3 inline-block">
                        📖 Guías & Artículos Técnicos
                    </span>
                    <h3 class="text-xl md:text-2xl font-bold text-white mb-2 font-[family-name:var(--font-space-grotesk)]">
                        ¿Buscas información aún más detallada?
                    </h3>
                    <p class="text-gray-300 text-sm font-light leading-relaxed">
                        Explora nuestros artículos en el Blog sobre rendimiento web en Astro, posicionamiento SEO local y servicios de drones en Chile.
                    </p>
                </div>
                <a href="/blog" class="px-6 py-3.5 rounded-full bg-[#2dd4bf] text-[#050511] font-semibold text-sm hover:bg-[#00f2ea] hover:shadow-[0_0_20px_rgba(0,242,234,0.5)] transition-all whitespace-nowrap">
                    Ir al Blog SEMTIC →
                </a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 4: CTA FINAL -->
    <section class="py-24 relative overflow-hidden" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-4xl">
            <div class="p-10 md:p-14 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0e103b] to-[#0a0a20] border border-[#3b82f6]/40 backdrop-blur-xl text-center relative overflow-hidden shadow-2xl">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-1 bg-gradient-to-r from-transparent via-[#00f2ea] to-transparent"></div>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold mb-4 text-white">
                    ¿Tienes una pregunta específica?
                </h2>
                <p class="text-gray-300 text-base md:text-lg max-w-xl mx-auto mb-8 font-light leading-relaxed">
                    Escríbenos directamente y un especialista de nuestro equipo responderá todas tus inquietudes de inmediato.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <a href="https://wa.me/56988169404?text=Hola,%20tengo%20una%20consulta%20sobre%20sus%20servicios" target="_blank" class="px-8 py-4 rounded-full bg-gradient-to-r from-[#25D366] to-[#2dd4bf] text-[#050511] font-extrabold text-sm uppercase tracking-wide hover:shadow-[0_0_30px_rgba(45,212,191,0.5)] transition-all transform hover:-translate-y-1 flex items-center gap-2">
                        💬 Hablar por WhatsApp
                    </a>
                    <a href="/contacto" class="px-8 py-4 rounded-full border border-[#2dd4bf] text-[#2dd4bf] font-semibold text-sm hover:bg-[#2dd4bf] hover:text-[#050511] transition-all">
                        Formulario de Contacto
                    </a>
                </div>
            </div>
        </div>
    </section>

</Layout>
