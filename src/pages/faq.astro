    <!-- Script interactivo para filtrar preguntas por categoría -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const filterButtons = document.querySelectorAll<HTMLButtonElement>(".faq-filter-btn");
            const faqItems = document.querySelectorAll<HTMLDetailsElement>(".faq-item");

            filterButtons.forEach((btn) => {
                btn.addEventListener("click", () => {
                    const selectedCat = btn.getAttribute("data-category") || "Todas";

                    filterButtons.forEach((b) => {
                        b.classList.remove("bg-[#2dd4bf]", "text-[#050511]", "border-[#2dd4bf]", "shadow-[0_0_20px_rgba(45,212,191,0.35)]");
                        b.classList.add("bg-white/[0.04]", "text-gray-300", "border-white/10");
                    });
                    btn.classList.remove("bg-white/[0.04]", "text-gray-300", "border-white/10");
                    btn.classList.add("bg-[#2dd4bf]", "text-[#050511]", "border-[#2dd4bf]", "shadow-[0_0_20px_rgba(45,212,191,0.35)]");

                    let firstVisibleOpened = false;
                    faqItems.forEach((item) => {
                        const itemCat = item.getAttribute("data-faq-category");
                        if (selectedCat === "Todas" || itemCat === selectedCat) {
                            item.style.display = "block";
                            if (!firstVisibleOpened) {
                                item.open = true;
                                firstVisibleOpened = true;
                            } else {
                                item.open = false;
                            }
                        } else {
                            item.style.display = "none";
                            item.open = false;
                        }
                    });
                });
            });
        });
    </script>

