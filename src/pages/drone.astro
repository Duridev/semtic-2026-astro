---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const dronePillars = [
    {
        badge: "Impacto Comercial • Redes & Ads",
        title: "Producción Audiovisual & Marketing",
        image: "/cards-img/Producción Audiovisual & Marketing.webp",
        imageAlt: "Producción audiovisual con dron en 4K para marketing inmobiliario, turismo y empresas",
        description:
            "Fotografía y video aéreo cinematográfico en 4K para destacar proyectos inmobiliarios, parcelas, hoteles, eventos corporativos y campañas publicitarias en Google y Meta Ads.",
        features: [
            "Fotografía y video aéreo en ultra alta definición 4K (60 fps)",
            "Formatos optimizados: Horizontal (16:9) para Web/YouTube y Vertical (9:16) para Reels/TikTok",
            "Tomas combinadas aéreas y terrestres estabilizadas para empresas",
            "Videos promocionales listos para campañas de alta conversión"
        ],
        ctaText: "Cotizar Producción Audiovisual →",
        whatsappMsg: "Hola SEMTIC, me interesa cotizar producción audiovisual y marketing con Dron.",
        borderHover: "hover:border-[#3b82f6]/60",
        accentText: "text-[#60a5fa]",
        accentBadge: "bg-[#3b82f6]/10 text-[#60a5fa] border-[#3b82f6]/30"
    },
    {
        badge: "Precisión Técnica • Construcción & Agro",
        title: "Inspecciones Técnicas & Ingeniería",
        image: "/cards-img/Inspecciones & Ingeniería.webp",
        imageAlt: "Inspección técnica de techumbres, seguimiento de obras y fotogrametría con dron",
        description:
            "Levantamientos y análisis visuales aéreos de alta precisión para constructoras, industrias, plantas solares, agricultura y administración de edificios sin exponer personal a riesgos en altura.",
        features: [
            "Inspección detallada de techumbres, galpones, fachadas y estructuras",
            "Seguimiento periódico de avance de obras (semanal o mensual)",
            "Fotogrametría, ortomosaicos y levantamientos topográficos aéreos",
            "Supervisión de predios agrícolas, riegos y faenas industriales"
        ],
        ctaText: "Cotizar Inspección o Seguimiento →",
        whatsappMsg: "Hola SEMTIC, necesito cotizar una inspección técnica o seguimiento de obra con Dron.",
        borderHover: "hover:border-[#2dd4bf]/60",
        accentText: "text-[#2dd4bf]",
        accentBadge: "bg-[#2dd4bf]/10 text-[#2dd4bf] border-[#2dd4bf]/30"
    },
    {
        badge: "Postproducción • Vuelo Regulado",
        title: "Edición Profesional & Normativa DGAC",
        image: "/cards-img/Edicion Registro & Normativa.webp",
        imageAlt: "Edición de video profesional y operaciones con dron autorizadas por la DGAC Chile",
        description:
            "Entregamos tus piezas listas para publicar con edición profesional, corrección de color y total respaldo normativo ante la Dirección General de Aeronáutica Civil (DGAC).",
        features: [
            "Edición de video, etalonaje (color grading), textos dinámicos y música licenciada",
            "Panorámicas 360° interactivas para loteos y proyectos inmobiliarios",
            "Pilotos con credencial RPAS vigente bajo normativa DAN 91 y DAN 151",
            "Planificación de vuelo segura y gestión de permisos operacionales"
        ],
        ctaText: "Consultar Operación & Edición →",
        whatsappMsg: "Hola SEMTIC, quiero consultar por servicios de grabación aérea regulada y edición.",
        borderHover: "hover:border-[#00f2ea]/60",
        accentText: "text-[#00f2ea]",
        accentBadge: "bg-[#00f2ea]/10 text-[#00f2ea] border-[#00f2ea]/30"
    }
];

const flightWorkflow = [
    {
        step: "01",
        title: "Factibilidad & Plan de Vuelo",
        description: "Evaluamos la ubicación en Valparaíso, Santiago o región, verificamos el espacio aéreo DGAC y definimos los objetivos visuales o técnicos."
    },
    {
        step: "02",
        title: "Operación en Terreno 4K",
        description: "Desplegamos nuestro equipo en la fecha acordada cumpliendo todos los protocolos de seguridad para capturar cada ángulo requerido."
    },
    {
        step: "03",
        title: "Edición & Postproducción",
        description: "Procesamos el material en alta resolución, aplicando corrección de color, estabilización y formatos listos para web, redes o informes."
    },
    {
        step: "04",
        title: "Entrega Digital Rápida",
        description: "Recibes tus videos y fotografías mediante enlace privado en la nube en alta calidad, listos para presentar o lanzar en campañas Ads."
    }
];
---

<Layout
    title="Servicios Profesionales con Dron en Valparaíso y Santiago | SEMTIC"
    description="Fotografía y video aéreo 4K, inspección técnica de techumbres, fotogrametría y seguimiento de obras con drones certificados DGAC en la Región de Valparaíso y Región Metropolitana de Santiago."
    image="https://semtic.cl/social-img.webp"
>
    <!-- SECCIÓN 1: HERO -->
    <section class="relative min-h-[75vh] flex items-center justify-center pt-32 pb-20 overflow-hidden" style="z-index: 10;">
        <!-- Luces y destellos neón -->
        <div class="absolute top-1/4 left-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#3b82f6] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#2dd4bf] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/3 right-10 w-64 h-64 bg-[#00f2ea] rounded-full mix-blend-screen filter blur-[120px] opacity-15"></div>

        <div class="relative z-10 text-center px-4 max-w-5xl mx-auto hero-container">
            <div class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-white/5 border border-[#3b82f6]/40 backdrop-blur-md mb-6 shadow-lg">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00f2ea] animate-ping"></span>
                <span class="text-xs sm:text-sm uppercase tracking-widest text-[#00f2ea] font-bold">
                    Pilotos Certificados DGAC Chile • Grabación 4K UHD &amp; 360°
                </span>
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-[family-name:var(--font-space-grotesk)] font-bold mb-6 leading-tight text-white">
                Servicios Profesionales con Dron en <br class="hidden lg:block"/>
                <span class="text-gradient">Valparaíso, Santiago y Todo Chile</span>
            </h1>

            <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto mb-10 font-light leading-relaxed">
                Elevamos el impacto comercial de tus proyectos inmobiliarios, obras e industrias con <strong class="text-white font-medium">fotografía y video aéreo 4K</strong>, <strong class="text-white font-medium">inspecciones técnicas</strong> y <strong class="text-white font-medium">seguimiento de obras</strong> en la <span class="text-[#00f2ea] font-normal">Región de Valparaíso y Región Metropolitana de Santiago</span>.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10">
                <a href="https://wa.me/56988169404?text=Hola%20Semtic!%20Me%20interesa%20cotizar%20un%20servicio%20con%20Dron" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-[#3b82f6] via-[#2dd4bf] to-[#00f2ea] rounded-full text-[#050511] font-extrabold text-base tracking-wide hover:shadow-[0_0_30px_rgba(59,130,246,0.6)] transition-all duration-300 transform hover:-translate-y-1 uppercase flex items-center justify-center gap-2">
                    🛸 Cotizar Servicio con Dron
                </a>
                <a href="#demostraciones" class="w-full sm:w-auto px-8 py-4 rounded-full border border-white/20 bg-white/5 backdrop-blur-md text-white font-semibold text-base hover:bg-white/10 hover:border-[#00f2ea]/50 transition-all duration-300 text-center">
                    Ver Trabajos en Video ↓
                </a>
            </div>

            <!-- Micro-credenciales bajo los botones -->
            <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs sm:text-sm text-gray-300">
                <div class="flex items-center gap-2">
                    <span class="text-[#00f2ea] font-bold">✓</span>
                    <span>Credencial RPAS DGAC (Normativa DAN 91 / 151)</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[#2dd4bf] font-bold">✓</span>
                    <span>Calidad Cinematográfica 4K y Vertical 9:16</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[#60a5fa] font-bold">✓</span>
                    <span>Despliegue ágil en V Región y RM</span>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: COMPARATIVA VISUAL (PERSPECTIVA LIMITADA VS OPERACIÓN PROFESIONAL SEMTIC) -->
    <section id="ventaja-aerea" class="py-20 relative scroll-mt-28 border-y border-white/10 bg-[#070716]/70" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center max-w-3xl mx-auto mb-14">
                <span class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#3b82f6]/10 text-[#60a5fa] border border-[#3b82f6]/30 mb-3 inline-block uppercase tracking-wider">
                    Seguridad Operacional &amp; Alto Impacto Visual
                </span>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4 leading-tight">
                    ¿Por qué elegir una <span class="text-gradient">operación aérea profesional</span>?
                </h2>
                <p class="text-gray-300 text-base md:text-lg font-light">
                    Mostrar un terreno, proyecto inmobiliario o planta industrial solo desde el suelo limita su valor percibido, y volar sin acreditación expone a tu empresa a riesgos innecesarios.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
                <!-- Columna 1: Registro Convencional / Vuelos Informales -->
                <div class="p-7 sm:p-9 rounded-3xl bg-[#0a0a1a]/75 border border-rose-500/25 backdrop-blur-xl flex flex-col justify-between relative overflow-hidden group shadow-xl">
                    <div>
                        <div class="relative h-52 sm:h-56 w-full rounded-2xl overflow-hidden mb-6 border border-rose-500/25 bg-[#050511]">
                            <img
                                src="/servicios-img/web-lenta.jpg"
                                alt="Limitaciones del registro tradicional a ras de suelo y vuelos sin planificación técnica"
                                width="640"
                                height="360"
                                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                                loading="lazy"
                                decoding="async"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a] via-[#0a0a1a]/20 to-transparent"></div>
                            <div class="absolute top-3.5 left-3.5 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#050511]/90 border border-rose-500/40 text-rose-300 text-xs font-semibold uppercase tracking-wider backdrop-blur-md">
                                <span class="text-rose-400 font-bold">✕</span>
                                Limitaciones Frecuentes
                            </div>
                        </div>

                        <div class="flex items-center gap-3 mb-3">
                            <span class="w-8 h-8 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-sm shrink-0">✕</span>
                            <h3 class="text-xl sm:text-2xl font-bold text-rose-100 font-[family-name:var(--font-space-grotesk)]">
                                Tomas a Ras de Suelo o Vuelos sin Certificación
                            </h3>
                        </div>

                        <p class="text-gray-300 text-sm sm:text-base mb-6 leading-relaxed font-light">
                            Fotografías convencionales que no logran dimensionar tu proyecto o grabaciones amateur sin respaldo normativo.
                        </p>

                        <ul class="space-y-4 text-sm sm:text-base text-gray-300 font-light">
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 text-xs font-bold">✕</span>
                                <span><strong class="text-white font-semibold">Perspectiva incompleta:</strong> En parcelas, condominios o naves industriales no se aprecia el entorno, accesos ni dimensiones reales.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 text-xs font-bold">✕</span>
                                <span><strong class="text-white font-semibold">Inspecciones lentas y riesgosas:</strong> Subir personal a techumbres o estructuras en altura implica altos costos y riesgos laborales.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 text-xs font-bold">✕</span>
                                <span><strong class="text-white font-semibold">Riesgo normativo en empresas:</strong> Contratar operadores sin credencial DGAC vigente incumple protocolos de seguridad en faena.</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-8 pt-4 border-t border-rose-500/20 flex items-center justify-between text-xs text-gray-400">
                        <span>Impacto visual: <strong class="text-rose-400">Limitado</strong></span>
                        <span>Sin respaldo técnico</span>
                    </div>
                </div>

                <!-- Columna 2: Operación Profesional SEMTIC -->
                <div class="p-7 sm:p-9 rounded-3xl bg-[#0a0a1a]/90 border border-[#3b82f6]/45 backdrop-blur-xl shadow-2xl shadow-[#3b82f6]/10 flex flex-col justify-between relative overflow-hidden group">
                    <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-[#3b82f6] via-[#2dd4bf] to-[#00f2ea]"></div>
                    <div>
                        <div class="relative h-52 sm:h-56 w-full rounded-2xl overflow-hidden mb-6 border border-[#3b82f6]/35 bg-[#050511] p-3 flex items-center justify-center">
                            <img
                                src="/cards-img/Edicion Registro & Normativa.webp"
                                alt="Operación de drones certificada por la DGAC con grabación 4K en Valparaíso y Santiago"
                                width="560"
                                height="320"
                                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 drop-shadow-[0_0_25px_rgba(59,130,246,0.3)]"
                                loading="lazy"
                                decoding="async"
                            />
                            <div class="absolute top-3.5 left-3.5 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#050511]/90 border border-[#00f2ea]/50 text-[#00f2ea] text-xs font-semibold uppercase tracking-wider backdrop-blur-md">
                                <span>🛸</span>
                                Estándar Aéreo SEMTIC
                            </div>
                        </div>

                        <div class="flex items-center gap-3 mb-3">
                            <span class="w-8 h-8 rounded-full bg-[#2dd4bf]/20 text-[#2dd4bf] flex items-center justify-center font-bold text-sm shrink-0">✓</span>
                            <h3 class="text-xl sm:text-2xl font-bold text-white font-[family-name:var(--font-space-grotesk)]">
                                Operación SEMTIC: Precisión 4K + Normativa DGAC
                            </h3>
                        </div>

                        <p class="text-gray-200 text-sm sm:text-base mb-6 leading-relaxed font-light">
                            Combinamos equipamiento aéreo de última generación, criterio publicitario y cumplimiento estricto de la normativa aeronáutica chilena.
                        </p>

                        <ul class="space-y-4 text-sm sm:text-base text-gray-200 font-light">
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-[#2dd4bf]/20 text-[#2dd4bf] flex items-center justify-center shrink-0 text-xs font-bold">✓</span>
                                <span><strong class="text-white font-semibold">Perspectiva que acelera ventas:</strong> Muestra loteos, edificios, obras y entornos en 4K y 360° para captar la atención al instante.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-[#2dd4bf]/20 text-[#2dd4bf] flex items-center justify-center shrink-0 text-xs font-bold">✓</span>
                                <span><strong class="text-white font-semibold">Inspección segura sin detener faenas:</strong> Revisión de techumbres y estructuras en minutos con zoom de alta resolución.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-[#2dd4bf]/20 text-[#2dd4bf] flex items-center justify-center shrink-0 text-xs font-bold">✓</span>
                                <span><strong class="text-white font-semibold">Material listo para Marketing &amp; Ads:</strong> Entregamos piezas editadas en formato horizontal y Reels listas para tus campañas.</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-8 pt-4 border-t border-[#3b82f6]/25 flex items-center justify-between text-xs text-[#00f2ea] font-medium">
                        <span>Operación: <strong class="text-emerald-400">100% Regulada DGAC</strong></span>
                        <span>Resolución 4K UHD / 360°</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3: SOLUCIONES / 3 PILARES CON ILUSTRACIONES 3D -->
    <section id="especialidades" class="py-24 relative bg-gradient-to-b from-transparent via-[#0a0a20]/60 to-transparent scroll-mt-28" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center mb-16 max-w-3xl mx-auto">
                <span class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#3b82f6]/10 text-[#60a5fa] border border-[#3b82f6]/30 mb-3 inline-block uppercase tracking-wider">
                    🚁 Especialidades Aéreas
                </span>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    Soluciones <span class="text-gradient">Aéreas y Terrestres</span>
                </h2>
                <p class="text-gray-300 text-base md:text-lg font-light">
                    Dividimos nuestros servicios en tres áreas especializadas para responder tanto a objetivos comerciales de marketing como a requerimientos de ingeniería.
                </p>
            </div>

            <!-- Grid de Soluciones (3 Pilares) -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                {dronePillars.map((pilar) => (
                    <article class={`group relative p-7 sm:p-8 rounded-3xl bg-[#0a0a1a]/85 border border-white/10 backdrop-blur-xl ${pilar.borderHover} transition-all duration-500 hover:-translate-y-1.5 shadow-xl flex flex-col justify-between`}>
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-4">
                                <span class={`px-3 py-1 rounded-full text-xs font-semibold border ${pilar.accentBadge}`}>
                                    {pilar.badge}
                                </span>
                            </div>

                            <div class="relative h-44 w-full rounded-2xl bg-[#050511]/90 border border-white/10 p-4 mb-6 flex items-center justify-center overflow-hidden">
                                <img 
                                    src={pilar.image} 
                                    alt={pilar.imageAlt} 
                                    width="360"
                                    height="240"
                                    class="w-full h-36 object-contain group-hover:scale-105 transition-transform duration-500 filter drop-shadow-[0_0_20px_rgba(59,130,246,0.3)]" 
                                    loading="lazy" 
                                    decoding="async" 
                                />
                            </div>

                            <h3 class="text-2xl font-bold text-white mb-3 font-[family-name:var(--font-space-grotesk)] leading-snug">
                                {pilar.title}
                            </h3>

                            <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6 font-light">
                                {pilar.description}
                            </p>

                            <ul class="space-y-2.5 border-t border-white/10 pt-5 mb-6 text-gray-300 text-xs sm:text-sm font-light">
                                {pilar.features.map((feat) => (
                                    <li class="flex items-start gap-2">
                                        <span class={`${pilar.accentText} font-bold mt-0.5`}>✓</span>
                                        <span>{feat}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>

                        <div class="pt-4 border-t border-white/10">
                            <a
                                href={`https://wa.me/56988169404?text=${encodeURIComponent(pilar.whatsappMsg)}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold uppercase tracking-wider ${pilar.accentText} group-hover:text-white transition-colors`}
                            >
                                <span>{pilar.ctaText}</span>
                            </a>
                        </div>
                    </article>
                ))}
            </div>

            <!-- Proceso Operacional en 4 Pasos + Cobertura Local -->
            <div class="mt-20">
                <div class="text-center max-w-2xl mx-auto mb-12">
                    <span class="text-xs font-bold uppercase tracking-widest text-[#00f2ea] block mb-2">
                        Flujo de Trabajo Aéreo
                    </span>
                    <h3 class="text-2xl md:text-4xl font-bold text-white font-[family-name:var(--font-space-grotesk)]">
                        ¿Cómo planificamos y ejecutamos cada vuelo?
                    </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-14">
                    {flightWorkflow.map((item) => (
                        <div class="p-6 rounded-3xl bg-[#0a0a1a]/75 border border-white/10 hover:border-[#00f2ea]/40 transition-all">
                            <span class="text-2xl font-extrabold text-[#00f2ea] font-[family-name:var(--font-space-grotesk)] block mb-2">
                                {item.step}
                            </span>
                            <h4 class="text-lg font-bold text-white mb-2 font-[family-name:var(--font-space-grotesk)]">
                                {item.title}
                            </h4>
                            <p class="text-xs sm:text-sm text-gray-300 font-light leading-relaxed">
                                {item.description}
                            </p>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Banner Promocional a la Guía del Blog -->
            <div class="mt-10 p-8 md:p-10 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0d123b] to-[#0a0a20] border border-[#2dd4bf]/40 backdrop-blur-xl relative overflow-hidden shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="max-w-2xl">
                    <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-[#2dd4bf]/10 border border-[#2dd4bf]/30 text-[#2dd4bf] mb-3 inline-block">
                        📖 Guía Especializada 2026
                    </span>
                    <h3 class="text-xl md:text-2xl font-bold text-white mb-2 font-[family-name:var(--font-space-grotesk)]">
                        Fotografía y Grabación Aérea con Drones en Chile: Guía Definitiva
                    </h3>
                    <p class="text-gray-300 text-sm md:text-base font-light leading-relaxed">
                        Aprende cómo las tomas en 4K/360° y la fotogrametría transforman las ventas inmobiliarias, los eventos corporativos e inspecciones industriales.
