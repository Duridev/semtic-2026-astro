---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const adChannels = [
    {
        badge: "Captación de Demanda Alta • Búsqueda Activa",
        title: "Google Ads (Red de Búsqueda & Local)",
        image: "/ads-img/canal-google-ads.jpg",
        imageAlt: "Campañas de búsqueda en Google Ads con palabras clave de intención comercial y geolocalización",
        description:
            "Posicionamos tu empresa en el primer lugar de Google justo en el segundo exacto en que un cliente potencial busca contratar tu servicio o cotizar tu producto en tu ciudad o región.",
        features: [
            "Anuncios de Búsqueda (Search Ads) enfocados 100% en palabras clave con intención de compra",
            "Filtrado estricto de palabras clave negativas para no desperdiciar presupuesto en curiosos",
            "Segmentación geográfica por comunas en la Región de Valparaíso y Región Metropolitana",
            "Extensiones de llamada directa, ubicación en Google Maps y enlaces a WhatsApp"
        ],
        ctaText: "Cotizar Campaña en Google Ads →",
        whatsappMsg: "Hola SEMTIC, quiero cotizar una campaña publicitaria en Google Ads para mi negocio.",
        borderHover: "hover:border-[#39ff14]/60",
        accentText: "text-[#39ff14]",
        accentBadge: "bg-[#39ff14]/10 text-[#39ff14] border-[#39ff14]/30"
    },
    {
        badge: "Generación de Demanda • Remarketing Visual",
        title: "Meta Ads (Instagram & Facebook)",
        image: "/ads-img/canal-meta-ads.jpg",
        imageAlt: "Campañas publicitarias en Meta Ads para Instagram Reels, Stories y Facebook orientadas a WhatsApp",
        description:
            "Capturamos la atención de tu cliente ideal mientras navega en Instagram Reels, Stories y Facebook con anuncios persuasivos que abren conversaciones comerciales directo en tu WhatsApp.",
        features: [
            "Segmentación avanzada por ubicación, intereses comerciales y comportamientos de compra",
            "Campañas de mensajes directos a WhatsApp y formularios de clientes potenciales",
            "Anuncios dinámicos en formato Video Reel, Stories y Carrusel de alto impacto",
            "Remarketing estratégico para volver a impactar a quienes visitaron tu web sin cotizar"
        ],
        ctaText: "Cotizar Campaña en Meta Ads →",
        whatsappMsg: "Hola SEMTIC, quiero cotizar campañas en Meta Ads (Instagram y Facebook) para mi negocio.",
        borderHover: "hover:border-[#00f2ea]/60",
        accentText: "text-[#00f2ea]",
        accentBadge: "bg-[#00f2ea]/10 text-[#00f2ea] border-[#00f2ea]/30"
    }
];

const managementPillars = [
    {
        number: "01",
        badge: "Fase Técnica • Trazabilidad",
        title: "Estructuración, Píxel & Tag Manager",
        image: "/ads-img/pilar-pixel-tracking.jpg",
        imageAlt: "Configuración técnica de Google Tag Manager, GA4 y Píxel de conversiones",
        description:
            "Configuramos Google Tag Manager, Google Analytics 4 y el Píxel de Meta para medir cada clic al botón de WhatsApp, llamada telefónica o formulario enviado desde tu Landing Page.",
        deliverable: "Medición exacta de conversiones reales",
        borderHover: "hover:border-[#39ff14]/50",
        accentText: "text-[#39ff14]",
        accentBadge: "bg-[#39ff14]/10 text-[#39ff14] border-[#39ff14]/30"
    },
    {
        number: "02",
        badge: "Fase Creativa • Persuasión",
        title: "Creativos & Copywriting Comercial",
        image: "/ads-img/pilar-creativos-copy.jpg",
        imageAlt: "Diseño de anuncios publicitarios y redacción persuasiva para Google y Meta Ads",
        description:
            "Redactamos titulares con gancho comercial y estructuramos piezas gráficas y anuncios pensados para destacar frente a tu competencia y atraer clics calificados listos para cotizar.",
        deliverable: "Anuncios de alto CTR y relevancia",
        borderHover: "hover:border-[#00f2ea]/50",
        accentText: "text-[#00f2ea]",
        accentBadge: "bg-[#00f2ea]/10 text-[#00f2ea] border-[#00f2ea]/30"
    },
    {
        number: "03",
        badge: "Fase Continua • Rentabilidad",
        title: "Optimización Diaria & Escalamiento ROI",
        image: "/ads-img/pilar-optimizacion-roi.jpg",
        imageAlt: "Optimización continua de pujas, presupuesto y retorno de inversión publicitaria",
        description:
            "Ajustamos pujas, limpiamos términos de búsqueda irrelevantes, pausamos los anuncios de bajo rendimiento y redirigimos tu presupuesto hacia las campañas que generan más ventas.",
        deliverable: "Reducción de costo por prospecto (CPA)",
        borderHover: "hover:border-[#3b82f6]/50",
        accentText: "text-[#60a5fa]",
        accentBadge: "bg-[#3b82f6]/10 text-[#60a5fa] border-[#3b82f6]/30"
    }
];
---

<Layout 
    title="Agencia Google Ads y Meta Ads | Campañas Publicitarias en Santiago y Valparaíso" 
    description="Agencia especialista en campañas publicitarias en Google Ads y Meta Ads (Instagram y Facebook) en la Región Metropolitana de Santiago y Región de Valparaíso. Maximiza tus cotizaciones y ventas."
    image="https://semtic.cl/social-img.webp">

    <!-- SECCIÓN 1: HERO -->
    <section class="relative min-h-[75vh] flex items-center justify-center pt-32 pb-20 overflow-hidden" style="z-index: 10;">
        <!-- Luces y resplandores neón -->
        <div class="absolute top-1/4 left-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#39ff14] rounded-full mix-blend-screen filter blur-[140px] opacity-20 animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#00f2ea] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/3 right-10 w-64 h-64 bg-[#1877F2] rounded-full mix-blend-screen filter blur-[120px] opacity-15"></div>

        <div class="relative z-10 text-center px-4 max-w-5xl mx-auto hero-container">
            <div class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-white/5 border border-[#39ff14]/40 backdrop-blur-md mb-6 shadow-lg">
                <span class="w-2.5 h-2.5 rounded-full bg-[#39ff14] animate-ping"></span>
                <span class="text-xs sm:text-sm uppercase tracking-widest text-[#39ff14] font-bold">
                    Agencia de Publicidad Digital • Alto Retorno de Inversión (ROI)
                </span>
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-[family-name:var(--font-space-grotesk)] font-bold mb-6 leading-tight text-white">
                Campañas Publicitarias en Google &amp; Meta Ads <br class="hidden lg:block"/>
                <span class="text-gradient">Optimizadas para Multiplicar tus Ventas</span>
            </h1>

            <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto mb-10 font-light leading-relaxed">
                Como agencia especialista, ponemos tu negocio frente a las personas exactas en el momento preciso en que buscan contratar o comprar. Gestionamos <strong class="text-white font-medium">campañas de Google Ads y Meta Ads</strong> de alto rendimiento en la <span class="text-[#39ff14] font-normal">Región Metropolitana de Santiago y Región de Valparaíso</span>.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-10">
                <a href="https://wa.me/56988169404?text=Hola%20Semtic!%20Me%20interesa%20lanzar%20campañas%20de%20Google%20y%20Meta%20Ads" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-[#39ff14] via-[#00f2ea] to-[#3b82f6] rounded-full text-[#050511] font-extrabold text-base tracking-wide hover:shadow-[0_0_30px_rgba(57,255,20,0.6)] transition-all duration-300 transform hover:-translate-y-1 uppercase flex items-center justify-center gap-2">
                    🎯 Lanzar Mis Campañas Ads
                </a>
                <a href="#canales" class="w-full sm:w-auto px-8 py-4 rounded-full border border-white/20 bg-white/5 backdrop-blur-md text-white font-semibold text-base hover:bg-white/10 hover:border-[#39ff14]/50 transition-all duration-300 text-center">
                    Ver Estrategia Ads ↓
                </a>
            </div>

            <!-- Micro-credenciales bajo los botones -->
            <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs sm:text-sm text-gray-300">
                <div class="flex items-center gap-2">
                    <span class="text-[#39ff14] font-bold">✓</span>
                    <span>Palabras clave con intención directa de compra</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[#00f2ea] font-bold">✓</span>
                    <span>Filtrado de clics basura y palabras negativas</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[#60a5fa] font-bold">✓</span>
                    <span>Trazabilidad de conversiones a WhatsApp</span>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: COMPARATIVA VISUAL (BOTÓN PROMOCIONAR VS GESTIÓN CIENTÍFICA SEMTIC) -->
    <section id="comparativa-ads" class="py-20 relative scroll-mt-28 border-y border-white/10 bg-[#070716]/70" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center max-w-3xl mx-auto mb-14">
                <span class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#39ff14]/10 text-[#39ff14] border border-[#39ff14]/30 mb-3 inline-block uppercase tracking-wider">
                    ¿Cansado de gastar dinero sin ver resultados?
                </span>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4 leading-tight">
                    Por qué una campaña profesional supera al <span class="text-gradient">botón “Promocionar”</span>
                </h2>
                <p class="text-gray-300 text-base md:text-lg font-light">
                    Impulsar una publicación desde el celular es fácil, pero hacer que cada peso invertido regrese convertido en cotizaciones reales exige estructura técnica y segmentación avanzada.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
                <!-- Columna 1: Campañas Improvisadas / Botón Promocionar -->
                <div class="p-7 sm:p-9 rounded-3xl bg-[#0a0a1a]/75 border border-rose-500/25 backdrop-blur-xl flex flex-col justify-between relative overflow-hidden group shadow-xl">
                    <div>
                        <div class="relative h-52 sm:h-60 w-full rounded-2xl overflow-hidden mb-6 border border-rose-500/25 bg-[#050511]">
                            <img
                                src="/ads-img/ads-sin-estrategia.jpg"
                                alt="Presupuesto publicitario desperdiciado al usar el botón promocionar sin estrategia"
                                width="640"
                                height="360"
                                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                                loading="lazy"
                                decoding="async"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a] via-[#0a0a1a]/20 to-transparent"></div>
                            <div class="absolute top-3.5 left-3.5 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#050511]/90 border border-rose-500/40 text-rose-300 text-xs font-semibold uppercase tracking-wider backdrop-blur-md">
                                <span class="text-rose-400 font-bold">✕</span>
                                El Error Frecuente
                            </div>
                        </div>

                        <div class="flex items-center gap-3 mb-3">
                            <span class="w-8 h-8 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-sm shrink-0">✕</span>
                            <h3 class="text-xl sm:text-2xl font-bold text-rose-100 font-[family-name:var(--font-space-grotesk)]">
                                El Botón “Promocionar” y Anuncios sin Estrategia
                            </h3>
                        </div>

                        <p class="text-gray-300 text-sm sm:text-base mb-6 leading-relaxed font-light">
                            Campañas configuradas en modo automático que agotan tu presupuesto mostrando anuncios a usuarios sin intención de contratar.
                        </p>

                        <ul class="space-y-4 text-sm sm:text-base text-gray-300 font-light">
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 text-xs font-bold">✕</span>
                                <span><strong class="text-white font-semibold">Clics curiosos que no compran:</strong> Sin exclusión de palabras negativas (como “gratis”, “empleo”, “curso”), pagas por búsquedas inútiles.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 text-xs font-bold">✕</span>
                                <span><strong class="text-white font-semibold">Sin medición de conversiones:</strong> No sabes qué anuncio ni qué palabra clave generó realmente una venta o un mensaje.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-rose-500/20 text-rose-400 flex items-center justify-center shrink-0 text-xs font-bold">✕</span>
                                <span><strong class="text-white font-semibold">Tráfico enviado a páginas lentas:</strong> El usuario hace clic en tu anuncio pero cierra la ventana antes de que la web termine de abrir.</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-8 pt-4 border-t border-rose-500/20 flex items-center justify-between text-xs text-gray-400">
                        <span>Resultado habitual: <strong class="text-rose-400">Alto costo por clic</strong></span>
                        <span>Pocas cotizaciones reales</span>
                    </div>
                </div>

                <!-- Columna 2: Gestión Científica SEMTIC -->
                <div class="p-7 sm:p-9 rounded-3xl bg-[#0a0a1a]/90 border border-[#39ff14]/40 backdrop-blur-xl shadow-2xl shadow-[#39ff14]/5 flex flex-col justify-between relative overflow-hidden group">
                    <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-[#39ff14] via-[#00f2ea] to-[#3b82f6]"></div>
                    <div>
                        <div class="relative h-52 sm:h-60 w-full rounded-2xl overflow-hidden mb-6 border border-[#39ff14]/35 bg-[#050511]">
                            <img
                                src="/ads-img/ads-estrategia-semtic.jpg"
                                alt="Gestión científica de campañas en Google Ads y Meta Ads con alta conversión"
                                width="640"
                                height="360"
                                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                                loading="lazy"
                                decoding="async"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a] via-[#0a0a1a]/15 to-transparent"></div>
                            <div class="absolute top-3.5 left-3.5 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#050511]/90 border border-[#39ff14]/50 text-[#39ff14] text-xs font-semibold uppercase tracking-wider backdrop-blur-md">
                                <span>⚡</span>
                                Gestión Científica SEMTIC
                            </div>
                        </div>

                        <div class="flex items-center gap-3 mb-3">
                            <span class="w-8 h-8 rounded-full bg-[#39ff14]/20 text-[#39ff14] flex items-center justify-center font-bold text-sm shrink-0">✓</span>
                            <h3 class="text-xl sm:text-2xl font-bold text-white font-[family-name:var(--font-space-grotesk)]">
                                Método SEMTIC: Precisión + Conversión Directa
                            </h3>
                        </div>

                        <p class="text-gray-200 text-sm sm:text-base mb-6 leading-relaxed font-light">
                            Administramos tu presupuesto desde Google Ads Expert Mode y Meta Business Suite con foco 100% en generar oportunidades comerciales.
                        </p>

                        <ul class="space-y-4 text-sm sm:text-base text-gray-200 font-light">
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-[#39ff14]/20 text-[#39ff14] flex items-center justify-center shrink-0 text-xs font-bold">✓</span>
                                <span><strong class="text-white font-semibold">Intención de compra comprobada:</strong> Captamos a quienes buscan activamente contratar tu servicio hoy mismo en tu zona.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-[#39ff14]/20 text-[#39ff14] flex items-center justify-center shrink-0 text-xs font-bold">✓</span>
                                <span><strong class="text-white font-semibold">Algoritmo entrenado con ventas reales:</strong> Conectamos el Píxel y Tag Manager para que Google y Meta busquen más perfiles similares a tus compradores.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="mt-1 w-5 h-5 rounded-full bg-[#39ff14]/20 text-[#39ff14] flex items-center justify-center shrink-0 text-xs font-bold">✓</span>
                                <span><strong class="text-white font-semibold">Sinergia con Landing Pages rápidas:</strong> Mayor Nivel de Calidad del anuncio = menor costo por clic y más mensajes en tu WhatsApp.</span>
                            </li>
                        </ul>
                    </div>

                    <div class="mt-8 pt-4 border-t border-[#39ff14]/25 flex items-center justify-between text-xs text-[#39ff14] font-medium">
                        <span>Resultado: <strong class="text-white">Presupuesto 100% optimizado</strong></span>
                        <span>Cotizaciones diarias medibles</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3: CANALES DE CONVERSIÓN (GOOGLE VS META ADS CON IMÁGENES 3D GLASSMORPHISM) -->
    <section id="canales" class="py-24 relative bg-gradient-to-b from-transparent via-[#0a0a20]/60 to-transparent scroll-mt-28" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center mb-16 max-w-3xl mx-auto">
                <span class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#39ff14]/10 text-[#39ff14] border border-[#39ff14]/30 mb-3 inline-block uppercase tracking-wider">
                    📊 Canales Publicitarios Dominantes
                </span>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    La Combinación Perfecta de <span class="text-gradient">Google &amp; Meta Ads</span>
                </h2>
                <p class="text-gray-300 text-base md:text-lg font-light">
                    Unimos la búsqueda activa en Google con la visibilidad e impacto visual en Instagram y Facebook para dominar tu mercado local.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {adChannels.map((channel) => (
                    <article class={`p-7 sm:p-9 rounded-3xl bg-[#0a0a1a]/85 border border-white/10 backdrop-blur-xl relative overflow-hidden group ${channel.borderHover} transition-all duration-300 hover:-translate-y-1.5 shadow-xl flex flex-col justify-between`}>
                        <div>
                            <!-- Badge superior -->
                            <div class="flex items-center justify-between gap-2 mb-4">
                                <span class={`px-3.5 py-1 rounded-full text-xs font-semibold border ${channel.accentBadge}`}>
                                    {channel.badge}
                                </span>
                            </div>

                            <!-- Imagen 3D Glassmorphism (Reemplaza a los antiguos emojis 🔍 y 📱) -->
                            <div class="relative h-52 sm:h-56 w-full rounded-2xl overflow-hidden mb-6 border border-white/10 bg-[#050511] shadow-inner">
                                <img
                                    src={channel.image}
                                    alt={channel.imageAlt}
                                    width="560"
                                    height="350"
                                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a]/85 via-transparent to-transparent"></div>
                            </div>

                            <h3 class="text-2xl font-bold text-white mb-3 font-[family-name:var(--font-space-grotesk)] leading-snug">
                                {channel.title}
                            </h3>

                            <p class="text-gray-300 text-sm md:text-base font-light leading-relaxed mb-6">
                                {channel.description}
                            </p>

                            <ul class="space-y-3 text-xs sm:text-sm text-gray-300 border-t border-white/10 pt-5 mb-6 font-light">
                                {channel.features.map((feat) => (
                                    <li class="flex items-start gap-2.5">
                                        <span class={`${channel.accentText} font-bold mt-0.5`}>✓</span>
                                        <span>{feat}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>

                        <div class="pt-4 border-t border-white/10">
                            <a
                                href={`https://wa.me/56988169404?text=${encodeURIComponent(channel.whatsappMsg)}`}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider ${channel.accentText} group-hover:text-white transition-colors`}
                            >
                                <span>{channel.ctaText}</span>
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- SECCIÓN 4: QUÉ INCLUYE NUESTRA GESTIÓN PUBLICITARIA (CON IMÁGENES 3D GLASSMORPHISM) -->
    <section id="gestion" class="py-20 relative border-t border-white/10 bg-[#070716]/50 scroll-mt-28" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center mb-16 max-w-3xl mx-auto">
                <span class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#00f2ea]/10 text-[#00f2ea] border border-[#00f2ea]/30 mb-3 inline-block uppercase tracking-wider">
                    ⚙️ Servicio Integral Llave en Mano
                </span>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    ¿Qué Incluye Nuestra <span class="text-gradient">Gestión Publicitaria</span>?
                </h2>
                <p class="text-gray-300 text-base md:text-lg font-light">
                    Nos encargamos de toda la arquitectura técnica, creativa y analítica de tus campañas para que tú te concentres únicamente en cerrar las ventas.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {managementPillars.map((pilar) => (
                    <article class={`p-6 sm:p-7 rounded-3xl bg-[#0a0a1a]/85 border border-white/10 backdrop-blur-xl relative ${pilar.borderHover} transition-all duration-300 hover:-translate-y-1.5 group flex flex-col justify-between shadow-xl`}>
                        <div>
                            <!-- Encabezado de la tarjeta -->
                            <div class="flex items-center justify-between gap-2 mb-4">
                                <span class={`px-3 py-1 rounded-full text-xs font-semibold border ${pilar.accentBadge}`}>
                                    {pilar.badge}
                                </span>
                                <span class="text-2xl font-extrabold text-white/25 font-[family-name:var(--font-space-grotesk)] group-hover:text-white/70 transition-colors">
                                    {pilar.number}
                                </span>
                            </div>

                            <!-- Imagen 3D Glassmorphism (Reemplaza a los emojis ⚙️, 🎨 y 📈) -->
                            <div class="relative h-44 w-full rounded-2xl overflow-hidden mb-5 border border-white/10 bg-[#050511] shadow-inner">
                                <img
                                    src={pilar.image}
                                    alt={pilar.imageAlt}
                                    width="420"
                                    height="315"
