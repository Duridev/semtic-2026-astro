---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout 
    title="Publicidad en Google y Meta Ads en Chile | SEMTIC" 
    description="Gestionamos tus campañas de publicidad digital en Google Ads, Facebook e Instagram para maximizar tu retorno de inversión en Santiago, Valparaíso y todo Chile."
    image="https://semtic.cl/social-img.webp">

    <!-- SECCIÓN 1: HERO -->
    <section class="relative min-h-[70vh] flex items-center justify-center pt-32 pb-20 overflow-hidden" style="z-index: 10;">
        <!-- Luces y resplandores neón -->
        <div class="absolute top-1/4 left-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#39ff14] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#00f2ea] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/3 right-10 w-64 h-64 bg-[#1877F2] rounded-full mix-blend-screen filter blur-[120px] opacity-15"></div>

        <div class="relative z-10 text-center px-4 max-w-5xl mx-auto hero-container">
            <div class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-white/5 border border-[#39ff14]/40 backdrop-blur-md mb-6">
                <span class="w-2.5 h-2.5 rounded-full bg-[#39ff14] animate-ping"></span>
                <span class="text-sm uppercase tracking-widest text-[#39ff14] font-bold">Publicidad Digital de Alto Retorno (ROI)</span>
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-[family-name:var(--font-space-grotesk)] font-bold mb-6 leading-tight text-white">
                Campañas de Google & Meta Ads <br class="hidden lg:block"/>
                <span class="text-gradient">Optimizadas para Multiplicar tus Ventas</span>
            </h1>

            <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto mb-10 font-light leading-relaxed">
                Ponemos tu marca frente a las personas exactas en el momento preciso en que están listas para cotizar y comprar. Gestión profesional de presupuestos publicitarios para negocios en Santiago, Valparaíso, Viña del Mar y todo Chile.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a href="https://wa.me/56988169404?text=Hola%20Semtic!%20Me%20interesa%20lanzar%20campañas%20de%20Google%20y%20Meta%20Ads" target="_blank" class="px-8 py-4 bg-gradient-to-r from-[#39ff14] via-[#00f2ea] to-[#3b82f6] rounded-full text-[#050511] font-extrabold text-base tracking-wide hover:shadow-[0_0_30px_rgba(57,255,20,0.6)] transition-all duration-300 transform hover:-translate-y-1 uppercase flex items-center gap-2">
                    🎯 Lanzar Mis Campañas Ads
                </a>
                <a href="#canales" class="px-8 py-4 rounded-full border border-white/20 bg-white/5 backdrop-blur-md text-white font-semibold text-base hover:bg-white/10 hover:border-[#39ff14]/50 transition-all duration-300">
                    Ver Estrategia Ads ↓
                </a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: EL PROBLEMA DEL BOTÓN "PROMOCIONAR" -->
    <section class="py-16 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-5xl">
            <div class="p-10 md:p-14 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl text-center relative overflow-hidden shadow-2xl">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-1 bg-gradient-to-r from-transparent via-[#39ff14] to-transparent"></div>
                <h2 class="text-sm md:text-base font-bold mb-4 text-[#39ff14] tracking-[0.25em] uppercase font-[family-name:var(--font-space-grotesk)]">¿Cansado de gastar dinero sin ver resultados?</h2>
                <p class="text-lg md:text-2xl text-gray-200 leading-relaxed font-light">
                    Presionar el botón azul 'Promocionar' en Instagram es fácil; <span class="text-[#39ff14] font-medium">hacer que un anuncio sea verdaderamente rentable exige estrategia.</span> En SEMTIC gestionamos tu presupuesto publicitario con enfoque científico: segmentación avanzada, pruebas de anuncios y embudos de conversión.
                </p>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3: CANALES DE CONVERSIÓN (Google vs Meta Ads) -->
    <section id="canales" class="py-20 relative bg-gradient-to-b from-transparent via-[#0a0a20]/60 to-transparent" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center mb-16">
                <span class="px-4 py-1.5 rounded-full text-sm font-semibold bg-[#39ff14]/10 text-[#39ff14] border border-[#39ff14]/30 mb-3 inline-block">
                    📊 Canales Publicitarios Dominantes
                </span>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    La Combinación Perfecta de <span class="text-gradient">Google & Meta Ads</span>
                </h2>
                <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto font-light">
                    Aprovechamos la intención directa de búsqueda en Google y la interrupción visual en redes sociales.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Tarjeta Google Ads -->
                <div class="p-8 md:p-10 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl relative overflow-hidden group hover:border-[#39ff14]/50 transition-all duration-300 hover:-translate-y-1 shadow-xl flex flex-col justify-between">
                    <div>
                        <div class="w-14 h-14 mb-6 rounded-2xl bg-[#39ff14]/10 border border-[#39ff14]/30 flex items-center justify-center text-[#39ff14] group-hover:scale-110 transition-transform">
                            🔍
                        </div>
                        <h3 class="text-2xl font-bold text-white mb-2 font-[family-name:var(--font-space-grotesk)]">Google Ads (Intención de Búsqueda)</h3>
                        <p class="text-xs md:text-sm text-[#39ff14] font-semibold uppercase tracking-wider mb-4">Captación de Demanda Alta</p>
                        <p class="text-gray-300 text-sm md:text-base font-light leading-relaxed mb-6">
                            Aparece en la parte superior de Google cuando las personas están buscando activamente tus productos o servicios en su ciudad o región.
                        </p>
                    </div>
                    <ul class="space-y-3 text-sm text-gray-300 border-t border-white/10 pt-4 font-light">
                        <li class="flex items-center gap-2"><span class="text-[#39ff14]">✓</span> Anuncios de Búsqueda (Search Ads) para palabras clave de compra</li>
                        <li class="flex items-center gap-2"><span class="text-[#39ff14]">✓</span> Campañas locales en Google Maps y búsqueda geo-localizada</li>
                        <li class="flex items-center gap-2"><span class="text-[#39ff14]">✓</span> Pago solo por clic de usuarios interesados</li>
                    </ul>
                </div>

                <!-- Tarjeta Meta Ads -->
                <div class="p-8 md:p-10 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl relative overflow-hidden group hover:border-[#1877F2]/50 transition-all duration-300 hover:-translate-y-1 shadow-xl flex flex-col justify-between">
                    <div>
                        <div class="w-14 h-14 mb-6 rounded-2xl bg-[#1877F2]/10 border border-[#1877F2]/30 flex items-center justify-center text-[#1877F2] group-hover:scale-110 transition-transform">
                            📱
                        </div>
                        <h3 class="text-2xl font-bold text-white mb-2 font-[family-name:var(--font-space-grotesk)]">Meta Ads (Facebook & Instagram)</h3>
                        <p class="text-xs md:text-sm text-[#1877F2] font-semibold uppercase tracking-wider mb-4">Generación de Deseo & Remarketing</p>
                        <p class="text-gray-300 text-sm md:text-base font-light leading-relaxed mb-6">
                            Anuncios visuales impactantes en Instagram Reels, Stories y Feed que capturan la atención e invitan a iniciar conversación por WhatsApp.
                        </p>
                    </div>
                    <ul class="space-y-3 text-sm text-gray-300 border-t border-white/10 pt-4 font-light">
                        <li class="flex items-center gap-2"><span class="text-[#00f2ea]">✓</span> Segmentación por intereses, comportamiento y ubicación</li>
                        <li class="flex items-center gap-2"><span class="text-[#00f2ea]">✓</span> Anuncios dinámicos en formato Reel y Carrusel</li>
                        <li class="flex items-center gap-2"><span class="text-[#00f2ea]">✓</span> Retargeting para recuperar visitas que no compraron</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 4: QUÉ INCLUYE NUESTRA GESTIÓN -->
    <section class="py-20 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    ¿Qué Incluye Nuestra <span class="text-gradient">Gestión Publicitaria</span>?
                </h2>
                <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto font-light">
                    Nos encargamos de todo el proceso técnico y creativo para que tú te enfoques en atender las ventas.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Pilar 1 -->
                <div class="p-8 rounded-3xl bg-[#0a0a1a]/60 border border-white/10 backdrop-blur-md relative hover:border-[#39ff14]/40 transition-all">
                    <div class="w-12 h-12 mb-6 rounded-xl bg-white/5 flex items-center justify-center text-[#39ff14] border border-white/10">
                        ⚙️
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-[family-name:var(--font-space-grotesk)]">Estructuración & Píxel</h3>
                    <p class="text-sm md:text-base text-gray-300 font-light leading-relaxed">
                        Instalación del Píxel de Meta y Google Tag Manager para medir eventos clave como clics en WhatsApp y envíos de formularios.
                    </p>
                </div>

                <!-- Pilar 2 -->
                <div class="p-8 rounded-3xl bg-[#0a0a1a]/60 border border-white/10 backdrop-blur-md relative hover:border-[#00f2ea]/40 transition-all">
                    <div class="w-12 h-12 mb-6 rounded-xl bg-white/5 flex items-center justify-center text-[#00f2ea] border border-white/10">
                        🎨
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-[family-name:var(--font-space-grotesk)]">Creativos & Copywriting</h3>
                    <p class="text-sm md:text-base text-gray-300 font-light leading-relaxed">
                        Diseño de imágenes y videos publicitarios acompañados de textos persuasivos que incentivan el llamado a la acción.
                    </p>
                </div>

                <!-- Pilar 3 -->
                <div class="p-8 rounded-3xl bg-[#0a0a1a]/60 border border-white/10 backdrop-blur-md relative hover:border-[#3b82f6]/40 transition-all">
                    <div class="w-12 h-12 mb-6 rounded-xl bg-white/5 flex items-center justify-center text-[#3b82f6] border border-white/10">
                        📈
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3 font-[family-name:var(--font-space-grotesk)]">Optimización Diaria</h3>
                    <p class="text-sm md:text-base text-gray-300 font-light leading-relaxed">
                        Ajustes constantes en pujas, exclusión de audiencias no rentables y redistribución de presupuesto hacia los anuncios ganadores.
                    </p>
                </div>
            </div>

            <div class="mt-12 text-center text-sm text-gray-400 italic">
                * Nota: La inversión publicitaria pagada a las plataformas (Google/Meta) se administra de forma transparente e independiente a la tarifa de gestión.
            </div>
        </div>
    </section>

    <!-- SECCIÓN 5: BANNER BLOG -->
    <section class="py-10 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-5xl">
            <div class="p-8 md:p-10 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0d123b] to-[#0a0a20] border border-[#39ff14]/40 backdrop-blur-xl relative overflow-hidden shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="max-w-2xl">
                    <span class="px-4 py-1 rounded-full text-xs md:text-sm font-semibold bg-[#39ff14]/10 border border-[#39ff14]/30 text-[#39ff14] mb-3 inline-block">
                        📖 Contenido del Blog SEMTIC
                    </span>
                    <h3 class="text-xl md:text-2xl font-bold text-white mb-2 font-[family-name:var(--font-space-grotesk)]">
                        Estrategias de SEO y Publicidad Pagada para Negocios en Chile
                    </h3>
                    <p class="text-gray-300 text-sm md:text-base font-light leading-relaxed">
                        Aprende cómo posicionar tu empresa en Valparaíso y Santiago combinando campañas de Ads con estrategias SEO a largo plazo.
                    </p>
                </div>
                <a href="/blog" class="px-6 py-3.5 rounded-full bg-[#39ff14] text-[#050511] font-semibold text-sm hover:bg-[#00f2ea] hover:shadow-[0_0_20px_rgba(57,255,20,0.5)] transition-all whitespace-nowrap">
                    Leer Artículos →
                </a>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 6: CTA FINAL -->
    <section class="py-24 relative overflow-hidden" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-5xl">
            <div class="p-10 md:p-14 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0e103b] to-[#0a0a20] border border-[#39ff14]/40 backdrop-blur-xl text-center relative overflow-hidden shadow-2xl">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-1 bg-gradient-to-r from-transparent via-[#39ff14] to-transparent"></div>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold mb-6 text-white leading-tight">
                    Estás a un clic de dejar de gastar y <br/><span class="text-gradient">empezar a rentabilizar tus anuncios</span>
                </h2>
                <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto mb-8 font-light leading-relaxed">
                    Conversemos sobre tu negocio. Realizamos un diagnóstico inicial y te proponemos la mejor estrategia para Google & Meta Ads.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <a href="https://wa.me/56988169404?text=Hola,%20quisiera%20cotizar%20la%20gestión%20de%20mis%20campañas%20de%20Google%20y%20Meta%20Ads" target="_blank" class="px-8 py-4 rounded-full bg-gradient-to-r from-[#25D366] to-[#39ff14] text-[#050511] font-extrabold text-base uppercase tracking-wide hover:shadow-[0_0_30px_rgba(57,255,20,0.5)] transition-all transform hover:-translate-y-1 flex items-center gap-2">
                        🎯 Lanzar Mis Campañas Ads
                    </a>
                    <a href="/contacto" class="px-8 py-4 rounded-full border border-[#39ff14] text-[#39ff14] font-semibold text-base hover:bg-[#39ff14] hover:text-[#050511] transition-all">
                        Ver Canales de Contacto
                    </a>
                </div>
            </div>
        </div>
    </section>

</Layout>
