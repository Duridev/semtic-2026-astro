    <!-- SCRIPT DEL CANVAS DEL TOROIDE -->
    <script>
        function initTorusCanvas() {
            const canvas = document.getElementById('torusCanvas') as HTMLCanvasElement;
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            let width: number, height: number;
            let particles: Particle[] = [];
            let animationFrameId: number;
            let isVisible = false;
            
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const timeMultiplier = prefersReducedMotion ? 0.05 : 1;
            const speedMultiplier = prefersReducedMotion ? 0 : 1;

            const colors = ['#2dd4bf', '#3b82f6', '#4f46e5', '#818cf8', '#00f2ea'];

            function resize() {
                const maxDpr = window.innerWidth < 768 ? 1.5 : 2;
                const dpr = Math.min(window.devicePixelRatio || 1, maxDpr);
                width = window.innerWidth;
                height = window.innerHeight;
                
                canvas.width = width * dpr;
                canvas.height = height * dpr;
                canvas.style.width = width + 'px';
                canvas.style.height = height + 'px';
                
                ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            }

            class Particle {
                u: number = 0;
                v: number = 0;
                R: number = 0;
                r: number = 0;
                color: string = '';
                size: number = 0;
                speedU: number = 0;
                speedV: number = 0;
                x2d: number = 0;
                y2d: number = 0;
                alpha: number = 0;

                constructor() {
                    this.reset();
                }

                reset() {
                    this.u = Math.random() * Math.PI * 2;
                    this.v = Math.random() * Math.PI * 2;
                    
                    this.R = 200 + Math.random() * 50;
                    this.r = 80 + Math.random() * 20;

                    this.color = colors[Math.floor(Math.random() * colors.length)];
                    this.size = Math.random() * 1.5;
                    this.speedU = (0.002 + Math.random() * 0.005) * speedMultiplier;
                    this.speedV = (0.001 + Math.random() * 0.003) * speedMultiplier;
                }

                update(timeInSecs: number) {
                    this.u += this.speedU;
                    this.v += this.speedV;

                    let x3d = (this.R + this.r * Math.cos(this.u)) * Math.cos(this.v);
                    let y3d = (this.R + this.r * Math.cos(this.u)) * Math.sin(this.v);
                    let z3d = this.r * Math.sin(this.u);

                    const time = timeInSecs * 0.3 * timeMultiplier;
                    
                    let yTemp = y3d * Math.cos(time) - z3d * Math.sin(time);
                    let zTemp = y3d * Math.sin(time) + z3d * Math.cos(time);
                    y3d = yTemp;
                    z3d = zTemp;

                    let xTemp = x3d * Math.cos(time * 0.5) - z3d * Math.sin(time * 0.5);
                    z3d = x3d * Math.sin(time * 0.5) + z3d * Math.cos(time * 0.5);
                    x3d = xTemp;

                    const scale = 800 / (800 + z3d);
                    this.x2d = width / 2 + x3d * scale;
                    this.y2d = height / 2 + y3d * scale;
                    this.alpha = scale;
                }

                draw() {
                    if (!ctx) return;
                    ctx.beginPath();
                    ctx.arc(this.x2d, this.y2d, this.size, 0, Math.PI * 2);
                    ctx.fillStyle = this.color;
                    ctx.globalAlpha = Math.max(0.1, (this.alpha - 0.5));
                    ctx.fill();
                    ctx.globalAlpha = 1;
                }
            }

            const particleCount = window.innerWidth < 768 ? 300 : window.innerWidth < 1024 ? 500 : 800;
            for (let i = 0; i < particleCount; i++) {
                particles.push(new Particle());
            }

            let startTime = Date.now();
            let pauseTimeOffset = 0;
            let lastPauseTime = 0;

            function animate() {
                if (!isVisible || !ctx) return; 
                
                ctx.fillStyle = 'rgba(5, 5, 17, 0.2)'; 
                ctx.fillRect(0, 0, width, height);

                const timeInSecs = (Date.now() - startTime - pauseTimeOffset) / 1000;

                particles.forEach(p => {
                    p.update(timeInSecs);
                    p.draw();
                });

                animationFrameId = requestAnimationFrame(animate);
            }

            let resizeTimeout: any;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(resize, 150);
            });
            resize();

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        if (!isVisible) {
                            isVisible = true;
                            if (lastPauseTime > 0) {
                                pauseTimeOffset += Date.now() - lastPauseTime;
                            }
                            animate();
                        }
                    } else {
                        isVisible = false;
                        cancelAnimationFrame(animationFrameId);
                        lastPauseTime = Date.now();
                    }
                });
            }, { threshold: 0 });
            
            const heroSection = document.getElementById('home');
            if (heroSection) {
                observer.observe(heroSection);
            } else {
                isVisible = true;
                animate();
            }
        }

        if (typeof window !== 'undefined') {
            window.addEventListener('load', () => {
                if ('requestIdleCallback' in window) {
                    (window as any).requestIdleCallback(initTorusCanvas, { timeout: 1000 });
                } else {
                    setTimeout(initTorusCanvas, 200);
                }
            });
        }
    </script>

