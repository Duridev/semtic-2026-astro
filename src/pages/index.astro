---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout 
    title="Desarrollo Web, SEO y Marketing Digital en Chile | SEMTIC Agencia" 
    description="Agencia de Desarrollo Web y Marketing Digital en Chile. Creamos sitios web de alta velocidad, e-commerce, SEO, campañas de Google & Meta Ads y servicios con dron. Aumenta tus ventas online." 
    image="https://semtic.cl/social-img.webp"
    ogType="website">

    <!-- Canvas Background para la Animación del Toroide -->
    <div id="canvas-container" class="overflow-hidden max-w-[100vw]">
        <canvas id="torusCanvas" class="block w-full h-full"></canvas>
    </div>

    <!-- SECCIÓN 1: HERO HEADER -->
    <header id="home" class="relative min-h-screen flex items-center justify-center pt-32 pb-20 overflow-hidden" style="z-index: 10;">
        <!-- Resplandores y Luces de Fondo -->
        <div class="absolute top-1/4 left-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#4f46e5] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#2dd4bf] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/3 right-10 w-64 h-64 bg-[#00f2ea] rounded-full mix-blend-screen filter blur-[120px] opacity-15"></div>

        <div class="relative z-10 text-center px-4 max-w-5xl mx-auto hero-container">
            <div class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-white/5 border border-[#2dd4bf]/40 backdrop-blur-md mb-6">
                <span class="w-2.5 h-2.5 rounded-full bg-[#00f2ea] animate-ping"></span>
                <span class="text-sm uppercase tracking-widest text-[#00f2ea] font-bold">⚡ Agencia Digital • Desarrollo Web • Marketing & Drones</span>
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-[family-name:var(--font-space-grotesk)] font-bold mb-6 leading-tight text-white">
                Sistemas Digitales y Publicidad que <br class="hidden md:block"/>
                <span class="text-gradient">Multiplican tus Ventas</span>
            </h1>

            <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto mb-10 font-light leading-relaxed">
                Desarrollo web de alta velocidad, posicionamiento SEO, gestión estratégica de Google & Meta Ads y producción con drones en Limache, Marga Marga, Valparaíso, Santiago y todo Chile. Enfocados 100% en tu retorno de inversión.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a href="https://wa.me/56988169404?text=Hola%20Semtic!%20Estoy%20buscando%20escalar%20las%20ventas%20de%20mi%20negocio%20digital%20y%20me%20gustaría%20recibir%20asesoría." target="_blank" class="px-8 py-4 bg-gradient-to-r from-[#2dd4bf] via-[#3b82f6] to-[#00f2ea] rounded-full text-[#050511] font-extrabold text-base tracking-wide hover:shadow-[0_0_30px_rgba(0,242,234,0.6)] transition-all duration-300 transform hover:-translate-y-1 uppercase flex items-center gap-2">
                    🚀 Agendar Asesoría Gratuita
                </a>
                <a href="#servicios" class="px-8 py-4 rounded-full border border-white/20 bg-white/5 backdrop-blur-md text-white font-semibold text-base hover:bg-white/10 hover:border-[#00f2ea]/50 transition-all duration-300">
                    Explorar Servicios ↓
                </a>
            </div>
        </div>
    </header>

    <!-- SECCIÓN 2: MARQUEE DE MARCAS (SOCIAL PROOF) -->
    <section class="py-12 md:py-16 border-y border-white/10 bg-[#0a0a1a]/60 backdrop-blur-md relative z-10">
        <div class="container mx-auto px-4">
            <p class="text-center text-gray-300 text-sm md:text-base font-bold tracking-[0.2em] uppercase mb-10">
                Empresas y Marcas que confían su crecimiento en SEMTIC
            </p>
            
            <div class="relative w-full flex overflow-hidden before:absolute before:left-0 before:top-0 before:z-10 before:h-full before:w-[50px] md:before:w-[150px] before:bg-gradient-to-r before:from-[#050511] before:to-transparent after:absolute after:right-0 after:top-0 after:z-10 after:h-full after:w-[50px] md:after:w-[150px] after:bg-gradient-to-l after:from-[#050511] after:to-transparent">
                <div class="flex w-max animate-marquee items-center">
                    <!-- Set 1 -->
                    <div class="flex gap-14 lg:gap-20 items-center px-6 lg:px-10">
                        <img src="/logos/Agrosilver.webp" alt="Agrosilver" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/DISTRIBUIDORA Nasa sin fondo.png" alt="Distribuidora Nasa" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Estrart logo.webp" alt="Estrart" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/La Chilenisima Fonda Logo-cuadrado.webp" alt="La Chilenisima" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Logo Ferret-R.webp" alt="Ferret-R" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Rebbel_Logo trans-cuadrado.webp" alt="Rebbel Arquitectura" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-ciudadsexshop.webp" alt="Ciudad Sexshop" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-rovegno.webp" alt="Rovegno" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                    </div>
                    <!-- Set 2 -->
                    <div class="flex gap-14 lg:gap-20 items-center px-6 lg:px-10">
                        <img src="/logos/Agrosilver.webp" alt="Agrosilver" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/DISTRIBUIDORA Nasa sin fondo.png" alt="Distribuidora Nasa" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Estrart logo.webp" alt="Estrart" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/La Chilenisima Fonda Logo-cuadrado.webp" alt="La Chilenisima" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Logo Ferret-R.webp" alt="Ferret-R" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Rebbel_Logo trans-cuadrado.webp" alt="Rebbel Arquitectura" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-ciudadsexshop.webp" alt="Ciudad Sexshop" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-rovegno.webp" alt="Rovegno" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-60 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3: SERVICIOS (4 DIMENSIONES) -->
    <section id="servicios" class="py-24 relative bg-gradient-to-b from-transparent via-[#0a0a20]/60 to-transparent" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-7xl">
            <div class="text-center mb-16 max-w-3xl mx-auto">
                <span class="px-4 py-1.5 rounded-full text-sm font-semibold bg-[#00f2ea]/10 text-[#00f2ea] border border-[#00f2ea]/30 mb-3 inline-block">
                    🌐 Ecosistema SEMTIC
                </span>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    Nuestras <span class="text-gradient">Dimensiones Digitales</span>
                </h2>
                <p class="text-gray-300 text-lg md:text-xl font-light">
                    Soluciones integrales diseñadas para construir marca, captar clientes y acelerar el crecimiento comercial.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 xl:gap-8">
                <!-- Card 1: Marketing Digital -->
                <div class="group relative p-6 xl:p-8 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl hover:border-[#4f46e5]/60 transition-all duration-500 hover:-translate-y-2 shadow-xl flex flex-col justify-between">
                    <div>
                        <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-[#4f46e5]/10 border border-[#4f46e5]/30 text-[#818cf8] mb-4 inline-block">
                            Estrategias 360°
                        </span>
                        <img 
                            src="/cards-img/card-mktn.webp" 
                            alt="Marketing Digital" 
                            class="w-full h-36 md:h-40 object-contain mb-6 group-hover:scale-105 transition-transform duration-500 filter drop-shadow-[0_0_20px_rgba(79,70,229,0.3)]" 
                            loading="lazy" 
                            decoding="async" 
                        />
                        <h3 class="text-2xl font-bold mb-3 text-white font-[family-name:var(--font-space-grotesk)]">Marketing Digital</h3>
                        <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6 font-light">
                            Estrategias continuas de contenidos, posicionamiento y gestión de redes sociales para aumentar tu autoridad de marca.
                        </p>
                    </div>
                    <a href="/agencia-marketing-digital" class="text-[#818cf8] text-sm font-bold uppercase tracking-wider group-hover:text-white transition-colors flex items-center gap-1.5 pt-4 border-t border-white/10">
                        Explorar Servicio →
                    </a>
                </div>

                <!-- Card 2: Desarrollo Web -->
                <div class="group relative p-6 xl:p-8 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl hover:border-[#00f2ea]/60 transition-all duration-500 hover:-translate-y-2 shadow-xl flex flex-col justify-between">
                    <div>
                        <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-[#00f2ea]/10 border border-[#00f2ea]/30 text-[#00f2ea] mb-4 inline-block">
                            Ultra Velocidad Astro
                        </span>
                        <img 
                            src="/cards-img/card-web.webp" 
                            alt="Desarrollo Web" 
                            class="w-full h-36 md:h-40 object-contain mb-6 group-hover:scale-105 transition-transform duration-500 filter drop-shadow-[0_0_20px_rgba(0,242,234,0.3)]" 
                            loading="lazy" 
                            decoding="async" 
                        />
                        <h3 class="text-2xl font-bold mb-3 text-white font-[family-name:var(--font-space-grotesk)]">Desarrollo Web</h3>
                        <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6 font-light">
                            Páginas web corporativas y e-commerce ultrarrápidos, optimizados para SEO y conversión instantánea en móviles.
                        </p>
                    </div>
                    <a href="/desarrollo-paginas-web" class="text-[#00f2ea] text-sm font-bold uppercase tracking-wider group-hover:text-white transition-colors flex items-center gap-1.5 pt-4 border-t border-white/10">
                        Explorar Servicio →
                    </a>
                </div>

                <!-- Card 3: Google & Meta Ads -->
                <div class="group relative p-6 xl:p-8 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl hover:border-[#39ff14]/60 transition-all duration-500 hover:-translate-y-2 shadow-xl flex flex-col justify-between">
                    <div>
                        <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-[#39ff14]/10 border border-[#39ff14]/30 text-[#39ff14] mb-4 inline-block">
                            ROI & Conversiones
                        </span>
                        <img 
                            src="/cards-img/card-meta-ads.webp" 
                            alt="Google & Meta Ads" 
                            class="w-full h-36 md:h-40 object-contain mb-6 group-hover:scale-105 transition-transform duration-500 filter drop-shadow-[0_0_20px_rgba(57,255,20,0.3)]" 
                            loading="lazy" 
                            decoding="async" 
                        />
                        <h3 class="text-2xl font-bold mb-3 text-white font-[family-name:var(--font-space-grotesk)]">Google & Meta Ads</h3>
                        <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6 font-light">
                            Campañas de anuncios pagados dirigidas a prospectos calificados en el momento exacto en que están listos para comprar.
                        </p>
                    </div>
                    <a href="/publicidad-google-meta-ads" class="text-[#39ff14] text-sm font-bold uppercase tracking-wider group-hover:text-white transition-colors flex items-center gap-1.5 pt-4 border-t border-white/10">
                        Explorar Servicio →
                    </a>
                </div>

                <!-- Card 4: Servicio de Dron -->
                <div class="group relative p-6 xl:p-8 rounded-3xl bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl hover:border-[#3b82f6]/60 transition-all duration-500 hover:-translate-y-2 shadow-xl flex flex-col justify-between">
                    <div>
                        <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-[#3b82f6]/10 border border-[#3b82f6]/30 text-[#60a5fa] mb-4 inline-block">
                            Tomas Aéreas 4K
                        </span>
                        <img 
                            src="/cards-img/card-drone.webp" 
                            alt="Vídeo con Drone" 
                            class="w-full h-36 md:h-40 object-contain mb-6 group-hover:scale-105 transition-transform duration-500 filter drop-shadow-[0_0_20px_rgba(59,130,246,0.3)]" 
                            loading="lazy" 
                            decoding="async" 
                        />
                        <h3 class="text-2xl font-bold mb-3 text-white font-[family-name:var(--font-space-grotesk)]">Servicio de Dron</h3>
                        <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6 font-light">
                            Fotografía 4K, video cinematográfico y seguimiento de obras bajo normativa DGAC en Valparaíso, Santiago y Chile.
                        </p>
                    </div>
                    <a href="/drone" class="text-[#60a5fa] text-sm font-bold uppercase tracking-wider group-hover:text-white transition-colors flex items-center gap-1.5 pt-4 border-t border-white/10">
                        Explorar Servicio →
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 4: PORTAFOLIO DESTACADO -->
    <section id="portafolio" class="py-24 relative" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-7xl">
            <div class="text-center mb-16 max-w-3xl mx-auto">
                <span class="px-4 py-1.5 rounded-full text-sm font-semibold bg-[#2dd4bf]/10 text-[#2dd4bf] border border-[#2dd4bf]/30 mb-3 inline-block">
                    📁 Proyectos Recientes
                </span>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    Casos de <span class="text-gradient">Éxito en Producción</span>
                </h2>
                <p class="text-gray-300 text-lg md:text-xl font-light">
                    Código limpio, arquitectura ágil y diseño enfocado en la generación directa de leads.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Project 1: TradeMaq -->
                <div class="group relative rounded-3xl overflow-hidden bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl hover:border-[#00f2ea]/60 transition-all duration-500 hover:-translate-y-2 shadow-xl flex flex-col justify-between">
                    <div>
                        <div class="aspect-video relative overflow-hidden bg-black">
                            <img src="/trademaq-hero.webp" alt="TradeMaq - Corretaje de Maquinaria" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90" loading="lazy" decoding="async">
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a] via-transparent to-transparent"></div>
                        </div>

                        <div class="p-6 md:p-8">
                            <h3 class="text-2xl font-bold mb-3 text-white font-[family-name:var(--font-space-grotesk)] group-hover:text-[#00f2ea] transition-colors">TradeMaq</h3>
                            <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6 font-light">
                                Plataforma de corretaje industrial especializada en maquinaria pesada con catálogo dinámico y cotización directa.
                            </p>
                            <div class="flex flex-wrap gap-2 mb-4">
                                <span class="px-3 py-1 bg-[#00f2ea]/10 border border-[#00f2ea]/30 rounded-full text-[#00f2ea] text-xs font-semibold">Web Premium</span>
                                <span class="px-3 py-1 bg-[#00f2ea]/10 border border-[#00f2ea]/30 rounded-full text-[#00f2ea] text-xs font-semibold">Catálogo Dinámico</span>
                            </div>
                        </div>
                    </div>

                    <div class="px-6 md:px-8 pb-8 pt-2">
                        <a href="https://dancing-begonia-f2bffb.netlify.app/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-[#00f2ea] text-sm font-bold uppercase tracking-wider group-hover:gap-2 gap-1.5 transition-all">
                            Ver Sitio en Vivo →
                        </a>
                    </div>
                </div>

                <!-- Project 2: Rebbel -->
                <div class="group relative rounded-3xl overflow-hidden bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl hover:border-[#4f46e5]/60 transition-all duration-500 hover:-translate-y-2 shadow-xl flex flex-col justify-between">
                    <div>
                        <div class="aspect-video relative overflow-hidden bg-black">
                            <img src="/rebbel-hero.webp" alt="Rebbel Arquitectura" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90" loading="lazy" decoding="async">
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a] via-transparent to-transparent"></div>
                        </div>

                        <div class="p-6 md:p-8">
                            <h3 class="text-2xl font-bold mb-3 text-white font-[family-name:var(--font-space-grotesk)] group-hover:text-[#818cf8] transition-colors">Rebbel Arquitectura</h3>
                            <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6 font-light">
                                Portafolio corporativo para estudio de arquitectura en Limache con galería visual interactiva y captación SEO.
                            </p>
                            <div class="flex flex-wrap gap-2 mb-4">
                                <span class="px-3 py-1 bg-[#4f46e5]/10 border border-[#4f46e5]/30 rounded-full text-[#818cf8] text-xs font-semibold">Diseño UI/UX</span>
                                <span class="px-3 py-1 bg-[#4f46e5]/10 border border-[#4f46e5]/30 rounded-full text-[#818cf8] text-xs font-semibold">SEO Local</span>
                            </div>
                        </div>
                    </div>

                    <div class="px-6 md:px-8 pb-8 pt-2">
                        <a href="https://rebbel.cl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-[#818cf8] text-sm font-bold uppercase tracking-wider group-hover:gap-2 gap-1.5 transition-all">
                            Ver Sitio en Vivo →
                        </a>
                    </div>
                </div>

                <!-- Project 3: Agrosilver -->
                <div class="group relative rounded-3xl overflow-hidden bg-[#0a0a1a]/80 border border-white/10 backdrop-blur-xl hover:border-[#39ff14]/60 transition-all duration-500 hover:-translate-y-2 shadow-xl flex flex-col justify-between">
                    <div>
                        <div class="aspect-video relative overflow-hidden bg-black">
                            <img src="/agrosilver-hero.webp" alt="Agrosilver Servicios Agrícolas" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-90" loading="lazy" decoding="async">
                            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a] via-transparent to-transparent"></div>
                        </div>

                        <div class="p-6 md:p-8">
                            <h3 class="text-2xl font-bold mb-3 text-white font-[family-name:var(--font-space-grotesk)] group-hover:text-[#39ff14] transition-colors">Agrosilver</h3>
                            <p class="text-gray-300 text-sm md:text-base leading-relaxed mb-6 font-light">
                                Sitio web de servicios agrícolas y de jardinería profesional en la Quinta Región optimizado para captación en WhatsApp.
                            </p>
                            <div class="flex flex-wrap gap-2 mb-4">
                                <span class="px-3 py-1 bg-[#39ff14]/10 border border-[#39ff14]/30 rounded-full text-[#39ff14] text-xs font-semibold">Captación WhatsApp</span>
                                <span class="px-3 py-1 bg-[#39ff14]/10 border border-[#39ff14]/30 rounded-full text-[#39ff14] text-xs font-semibold">SEO Técnico</span>
                            </div>
                        </div>
                    </div>

                    <div class="px-6 md:px-8 pb-8 pt-2">
                        <a href="https://agrosilver.cl" target="_blank" rel="noopener noreferrer" class="inline-flex items-center text-[#39ff14] text-sm font-bold uppercase tracking-wider group-hover:gap-2 gap-1.5 transition-all">
                            Ver Sitio en Vivo →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 5: FILOSOFÍA DEL TOROIDE (SPLIT SECTION) -->
    <section id="filosofia" class="py-20 bg-gradient-to-b from-transparent via-[#0a0a20]/60 to-transparent" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-6xl flex flex-col md:flex-row items-center gap-12">
            <div class="w-full md:w-1/2 relative">
                <div class="relative aspect-square max-w-md mx-auto p-4 rounded-3xl bg-[#0a0a1a]/40 border border-white/10 backdrop-blur-md shadow-2xl flex items-center justify-center">
                    <img src="/toroide.webp" alt="Toroide SEMTIC" class="toroide-image max-h-80 object-contain drop-shadow-[0_0_35px_rgba(0,242,234,0.4)]" loading="lazy" decoding="async">
                </div>
            </div>

