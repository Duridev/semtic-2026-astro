---
import Layout from '../layouts/Layout.astro';
import ProjectModal from '../components/ProjectModal.astro';
import { projectsData } from '../data/projects';
import '../styles/global.css';
---

<Layout 
    title="Agencia de Marketing Digital, Landing Page, Google Ads y Meta Ads en Valparaíso y Santiago" 
    description="Agencia SEMTIC: Diseño de Landing Pages ultrarrápidas, campañas publicitarias en Google Ads y Meta Ads, desarrollo web y SEO en la Región de Valparaíso y Región Metropolitana de Santiago." 
    image="https://semtic.cl/social-img.webp"
    ogType="website">

    <!-- Canvas Background para la Animación del Toroide -->
    <div id="canvas-container" class="overflow-hidden max-w-[100vw]">
        <canvas id="torusCanvas" class="block w-full h-full"></canvas>
    </div>

    <!-- SECCIÓN 1: HERO HEADER (Toroide intacto de fondo) -->
    <header id="home" class="relative min-h-screen flex items-center justify-center pt-32 pb-20 overflow-hidden" style="z-index: 10;">
        <!-- Resplandores y Luces de Fondo -->
        <div class="absolute top-1/4 left-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#4f46e5] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse"></div>
        <div class="absolute bottom-1/4 right-1/4 w-80 md:w-96 h-80 md:h-96 bg-[#2dd4bf] rounded-full mix-blend-screen filter blur-[140px] opacity-25 animate-pulse" style="animation-delay: 2s;"></div>
        <div class="absolute top-1/3 right-10 w-64 h-64 bg-[#00f2ea] rounded-full mix-blend-screen filter blur-[120px] opacity-15"></div>

        <div class="relative z-10 text-center px-4 max-w-5xl mx-auto hero-container">
            <div class="inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-[#0a0a1a]/75 border border-[#2dd4bf]/40 backdrop-blur-xl mb-7 shadow-[0_0_25px_rgba(45,212,191,0.15)]">
                <span class="w-2 h-2 rounded-full bg-[#00f2ea] animate-ping"></span>
                <span class="text-xs sm:text-sm uppercase tracking-[0.18em] text-[#00f2ea] font-bold">Ingeniería Web Astro • Google &amp; Meta Ads • Drones DGAC</span>
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-[family-name:var(--font-space-grotesk)] font-bold mb-6 leading-[1.1] tracking-tight text-white">
                Diseño de Landing Pages y Campañas Ads que <br class="hidden md:block"/>
                <span class="text-gradient">Multiplican tus Ventas</span>
            </h1>

            <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto mb-10 font-light leading-relaxed">
                Agencia especializada en diseño de <strong class="text-white font-medium">Landing Pages ultrarrápidas en Astro</strong>, campañas publicitarias de alto retorno en <strong class="text-white font-medium">Google Ads y Meta Ads</strong>, posicionamiento SEO y producción aérea con drones en la <strong class="text-[#2dd4bf] font-medium">Región de Valparaíso</strong> y la <strong class="text-[#2dd4bf] font-medium">Región Metropolitana de Santiago</strong>.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-14">
                <a href="https://wa.me/56988169404?text=Hola%20Semtic!%20Estoy%20buscando%20escalar%20las%20ventas%20de%20mi%20negocio%20digital%20y%20me%20gustaría%20recibir%20asesoría." target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-gradient-to-r from-[#2dd4bf] via-[#3b82f6] to-[#00f2ea] rounded-full text-white font-extrabold text-sm md:text-base tracking-wide uppercase flex items-center gap-2.5">
                    <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                    Agendar Asesoría Gratuita
                </a>
                <a href="#servicios" class="px-8 py-4 rounded-full border border-white/20 bg-white/5 backdrop-blur-md text-white font-semibold text-sm md:text-base transition-all duration-300 flex items-center gap-2">
                    Explorar Ecosistema
                    <svg class="w-4 h-4 text-[#00f2ea]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                </a>
            </div>

            <!-- Barra de Credenciales Glassmorphism en el Hero -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-4xl mx-auto text-left">
                <div class="p-4 rounded-2xl bg-[#0a0a1a]/75 border border-white/10 backdrop-blur-xl flex items-center gap-3.5 shadow-[0_10px_30px_rgba(0,0,0,0.45)]">
                    <div class="w-12 h-12 rounded-xl overflow-hidden border border-[#00f2ea]/40 shrink-0 bg-[#050511]">
                        <img src="/servicios-img/faq-astro-speed.jpg" alt="Velocidad extrema en Astro" class="w-full h-full object-cover" loading="eager" />
                    </div>
                    <div>
                        <div class="text-white font-bold text-sm font-[family-name:var(--font-space-grotesk)]">Carga &lt; 1 Segundo</div>
                        <div class="text-gray-400 text-xs">98–100/100 en Google PageSpeed</div>
                    </div>
                </div>
                <div class="p-4 rounded-2xl bg-[#0a0a1a]/75 border border-white/10 backdrop-blur-xl flex items-center gap-3.5 shadow-[0_10px_30px_rgba(0,0,0,0.45)]">
                    <div class="w-12 h-12 rounded-xl overflow-hidden border border-[#39ff14]/40 shrink-0 bg-[#050511]">
                        <img src="/ads-img/pilar-pixel-tracking.jpg" alt="Medición exacta de conversiones" class="w-full h-full object-cover" loading="eager" />
                    </div>
                    <div>
                        <div class="text-white font-bold text-sm font-[family-name:var(--font-space-grotesk)]">ROI 100% Trazable</div>
                        <div class="text-gray-400 text-xs">GA4, Tag Manager y Píxel activos</div>
                    </div>
                </div>
                <div class="p-4 rounded-2xl bg-[#0a0a1a]/75 border border-white/10 backdrop-blur-xl flex items-center gap-3.5 shadow-[0_10px_30px_rgba(0,0,0,0.45)]">
                    <div class="w-12 h-12 rounded-xl overflow-hidden border border-[#2dd4bf]/40 shrink-0 bg-[#050511]">
                        <img src="/servicios-img/about-direct-contact.jpg" alt="Trato directo sin intermediarios" class="w-full h-full object-cover" loading="eager" />
                    </div>
                    <div>
                        <div class="text-white font-bold text-sm font-[family-name:var(--font-space-grotesk)]">Sin Contratos de Amarre</div>
                        <div class="text-gray-400 text-xs">Trato directo con especialistas</div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- SECCIÓN 2: MARQUEE DE MARCAS (SOCIAL PROOF) -->
    <section class="py-12 md:py-16 border-y border-white/10 bg-[#0a0a1a]/75 backdrop-blur-xl relative z-10 overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-2/3 h-px bg-gradient-to-r from-transparent via-[#2dd4bf]/40 to-transparent"></div>
        <div class="container mx-auto px-4">
            <h2 class="text-center text-gray-300 text-xs md:text-sm font-bold tracking-[0.22em] uppercase mb-10">
                Empresas en Valparaíso y Santiago que confían su crecimiento en SEMTIC
            </h2>
            
            <div class="relative w-full flex overflow-hidden before:absolute before:left-0 before:top-0 before:z-10 before:h-full before:w-[50px] md:before:w-[150px] before:bg-gradient-to-r before:from-[#050511] before:to-transparent after:absolute after:right-0 after:top-0 after:z-10 after:h-full after:w-[50px] md:after:w-[150px] after:bg-gradient-to-l after:from-[#050511] after:to-transparent">
                <div class="flex w-max animate-marquee items-center">
                    <!-- Set 1 -->
                    <div class="flex gap-14 lg:gap-20 items-center px-6 lg:px-10">
                        <img src="/logos/Agrosilver.webp" alt="Agrosilver" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/DISTRIBUIDORA Nasa sin fondo.png" alt="Distribuidora Nasa" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Estrart logo.webp" alt="Estrart" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/La Chilenisima Fonda Logo-cuadrado.webp" alt="La Chilenisima" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Logo Ferret-R.webp" alt="Ferret-R" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Rebbel_Logo trans-cuadrado.webp" alt="Rebbel Arquitectura" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-ciudadsexshop.webp" alt="Ciudad Sexshop" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-rovegno.webp" alt="Rovegno" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-cuadrado-tmquinta.webp" alt="TM Quinta" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-sin-fondo.webp" alt="Fugas Detect" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                    </div>
                    <!-- Set 2 -->
                    <div class="flex gap-14 lg:gap-20 items-center px-6 lg:px-10">
                        <img src="/logos/Agrosilver.webp" alt="Agrosilver" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/DISTRIBUIDORA Nasa sin fondo.png" alt="Distribuidora Nasa" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Estrart logo.webp" alt="Estrart" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/La Chilenisima Fonda Logo-cuadrado.webp" alt="La Chilenisima" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Logo Ferret-R.webp" alt="Ferret-R" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/Rebbel_Logo trans-cuadrado.webp" alt="Rebbel Arquitectura" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-ciudadsexshop.webp" alt="Ciudad Sexshop" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-rovegno.webp" alt="Rovegno" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-cuadrado-tmquinta.webp" alt="TM Quinta" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                        <img src="/logos/logo-sin-fondo.webp" alt="Fugas Detect" class="h-14 md:h-16 w-auto max-w-[10rem] object-contain opacity-65 grayscale hover:opacity-100 hover:grayscale-0 transition-all duration-300" loading="lazy" decoding="async" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 3: SERVICIOS (4 DIMENSIONES CON VITRINAS 3D GLASSMORPHISM) -->
    <section id="servicios" class="py-24 relative bg-gradient-to-b from-transparent via-[#0a0a20]/60 to-transparent" style="z-index: 10;">
        <div class="container mx-auto px-4 max-w-7xl">
            <div class="text-center mb-16 max-w-3xl mx-auto">
                <span class="px-4 py-1.5 rounded-full text-xs uppercase tracking-widest font-bold bg-[#00f2ea]/10 text-[#00f2ea] border border-[#00f2ea]/30 mb-4 inline-flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#00f2ea]"></span>
                    Ecosistema de Crecimiento SEMTIC
                </span>
                <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    Servicios de nuestra <span class="text-gradient">Agencia Digital</span>
                </h2>
                <p class="text-gray-300 text-lg md:text-xl font-light">
                    Ingeniería web ultrarrápida, campañas publicitarias de precisión y producción audiovisual con drones diseñadas para captar clientes en Valparaíso y Santiago.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 xl:gap-7">
                <!-- Card 1: Marketing Digital -->
                <div class="group relative p-6 xl:p-7 rounded-3xl bg-[#0a0a1a]/85 border border-white/10 backdrop-blur-xl hover:border-[#818cf8]/60 transition-all duration-500 hover:-translate-y-2 shadow-[0_15px_40px_rgba(0,0,0,0.45)] flex flex-col justify-between overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-[#818cf8] to-transparent opacity-60 group-hover:opacity-100 transition-opacity"></div>
                    <div>
                        <div class="relative h-44 w-full rounded-2xl bg-[#050511]/90 border border-white/10 p-4 mb-6 flex items-center justify-center overflow-hidden">
                            <div class="absolute inset-0 bg-radial from-[#4f46e5]/20 via-transparent to-transparent opacity-80"></div>
                            <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[10px] uppercase tracking-wider font-bold bg-[#4f46e5]/15 border border-[#818cf8]/35 text-[#818cf8] z-10">
                                Estrategias 360°
                            </span>
                            <img 
                                src="/cards-img/card-mktn.webp" 
                                alt="Agencia de Marketing Digital y SEO" 
                                class="w-full h-32 object-contain relative z-10 group-hover:scale-110 transition-transform duration-500 filter drop-shadow-[0_0_20px_rgba(79,70,229,0.4)]" 
                                loading="lazy" 
                                decoding="async" 
                            />
                        </div>
                        <h3 class="text-xl xl:text-2xl font-bold mb-2.5 text-white font-[family-name:var(--font-space-grotesk)] group-hover:text-[#818cf8] transition-colors">Marketing Digital &amp; SEO</h3>
                        <p class="text-gray-300 text-sm leading-relaxed mb-5 font-light">
                            Posicionamiento SEO Local en Google, embudos B2B/B2C y estrategia comercial para multiplicar las cotizaciones de tu negocio.
                        </p>
                        <ul class="space-y-2 mb-6 text-xs text-gray-300">
                            <li class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#818cf8]"></span>
                                Posicionamiento orgánico local
                            </li>
                            <li class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#818cf8]"></span>
                                Embudos comerciales medibles
                            </li>
                        </ul>
                    </div>
                    <a href="/agencia-marketing-digital" class="text-[#818cf8] text-xs font-bold uppercase tracking-wider group-hover:text-white transition-colors flex items-center justify-between pt-4 border-t border-white/10">
                        <span>Explorar Servicio</span>
                        <span class="group-hover:translate-x-1 transition-transform">→</span>
                    </a>
                </div>

                <!-- Card 2: Desarrollo Web -->
                <div class="group relative p-6 xl:p-7 rounded-3xl bg-[#0a0a1a]/85 border border-white/10 backdrop-blur-xl hover:border-[#00f2ea]/60 transition-all duration-500 hover:-translate-y-2 shadow-[0_15px_40px_rgba(0,0,0,0.45)] flex flex-col justify-between overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-[#00f2ea] to-transparent opacity-60 group-hover:opacity-100 transition-opacity"></div>
                    <div>
                        <div class="relative h-44 w-full rounded-2xl bg-[#050511]/90 border border-white/10 p-4 mb-6 flex items-center justify-center overflow-hidden">
                            <div class="absolute inset-0 bg-radial from-[#00f2ea]/20 via-transparent to-transparent opacity-80"></div>
                            <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[10px] uppercase tracking-wider font-bold bg-[#00f2ea]/15 border border-[#00f2ea]/35 text-[#00f2ea] z-10">
                                Ultra Velocidad Astro
                            </span>
                            <img 
                                src="/cards-img/card-web.webp" 
                                alt="Diseño de Landing Pages y Desarrollo Web" 
                                class="w-full h-32 object-contain relative z-10 group-hover:scale-110 transition-transform duration-500 filter drop-shadow-[0_0_20px_rgba(0,242,234,0.4)]" 
                                loading="lazy" 
                                decoding="async" 
                            />
                        </div>
                        <h3 class="text-xl xl:text-2xl font-bold mb-2.5 text-white font-[family-name:var(--font-space-grotesk)] group-hover:text-[#00f2ea] transition-colors">Landing Pages &amp; Web</h3>
                        <p class="text-gray-300 text-sm leading-relaxed mb-5 font-light">
                            Sitios corporativos, E-Commerce y Landing Pages que cargan en menos de 1 segundo, diseñados para convertir clics en clientes.
                        </p>
                        <ul class="space-y-2 mb-6 text-xs text-gray-300">
                            <li class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#00f2ea]"></span>
                                98–100/100 Google PageSpeed
                            </li>
                            <li class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#00f2ea]"></span>
                                Diseño UX/UI Mobile-First
                            </li>
                        </ul>
                    </div>
                    <a href="/desarrollo-paginas-web" class="text-[#00f2ea] text-xs font-bold uppercase tracking-wider group-hover:text-white transition-colors flex items-center justify-between pt-4 border-t border-white/10">
                        <span>Explorar Servicio</span>
                        <span class="group-hover:translate-x-1 transition-transform">→</span>
                    </a>
                </div>

                <!-- Card 3: Google & Meta Ads -->
                <div class="group relative p-6 xl:p-7 rounded-3xl bg-[#0a0a1a]/85 border border-white/10 backdrop-blur-xl hover:border-[#39ff14]/60 transition-all duration-500 hover:-translate-y-2 shadow-[0_15px_40px_rgba(0,0,0,0.45)] flex flex-col justify-between overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-[#39ff14] to-transparent opacity-60 group-hover:opacity-100 transition-opacity"></div>
                    <div>
                        <div class="relative h-44 w-full rounded-2xl bg-[#050511]/90 border border-white/10 p-4 mb-6 flex items-center justify-center overflow-hidden">
                            <div class="absolute inset-0 bg-radial from-[#39ff14]/15 via-transparent to-transparent opacity-80"></div>
                            <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[10px] uppercase tracking-wider font-bold bg-[#39ff14]/15 border border-[#39ff14]/35 text-[#39ff14] z-10">
                                ROI &amp; Conversiones
                            </span>
                            <img 
                                src="/cards-img/card-meta-ads.webp" 
                                alt="Campañas en Google Ads y Meta Ads" 
                                class="w-full h-32 object-contain relative z-10 group-hover:scale-110 transition-transform duration-500 filter drop-shadow-[0_0_20px_rgba(57,255,20,0.35)]" 
                                loading="lazy" 
                                decoding="async" 
                            />
                        </div>
                        <h3 class="text-xl xl:text-2xl font-bold mb-2.5 text-white font-[family-name:var(--font-space-grotesk)] group-hover:text-[#39ff14] transition-colors">Google Ads &amp; Meta Ads</h3>
                        <p class="text-gray-300 text-sm leading-relaxed mb-5 font-light">
                            Campañas hiper-segmentadas que capturan clientes con intención de compra inmediata y miden cada contacto en WhatsApp.
                        </p>
                        <ul class="space-y-2 mb-6 text-xs text-gray-300">
                            <li class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#39ff14]"></span>
                                Búsqueda con intención de compra
                            </li>
                            <li class="flex items-center gap-2">
