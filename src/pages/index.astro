    <!-- SCRIPT INTERACTIVO DEL SIMULADOR COMPARATIVO (TABS + SLIDER BEFORE/AFTER) -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // 1. Control del Escáner Before / After
            const rangeInput = document.getElementById("ba-range-input") as HTMLInputElement | null;
            const oldOverlay = document.getElementById("ba-old-overlay") as HTMLElement | null;
            const dividerLine = document.getElementById("ba-divider-line") as HTMLElement | null;
            const presetBtns = document.querySelectorAll<HTMLButtonElement>(".ba-preset-btn");

            function updateSlider(val: number) {
                const clamped = Math.max(5, Math.min(95, val));
                if (oldOverlay) {
                    oldOverlay.style.clipPath = `inset(0 ${100 - clamped}% 0 0)`;
                }
                if (dividerLine) {
                    dividerLine.style.left = `${clamped}%`;
                }
                if (rangeInput) {
                    rangeInput.value = String(clamped);
                }
            }

            if (rangeInput) {
                rangeInput.addEventListener("input", () => {
                    updateSlider(Number(rangeInput.value));
                });
            }

            presetBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    const targetVal = Number(btn.getAttribute("data-ba-preset") || "50");
                    updateSlider(targetVal);
                });
            });

            // 2. Control de las 4 Pestañas de Telemetría
            const tabBtns = document.querySelectorAll<HTMLButtonElement>(".comp-tab-btn");
            const panels = document.querySelectorAll<HTMLElement>(".comp-panel");

            tabBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    const targetId = btn.getAttribute("data-comp-tab");
                    if (!targetId) return;

                    tabBtns.forEach((b) => {
                        b.classList.remove(
                            "bg-gradient-to-r",
                            "from-[#0d9488]/90",
                            "to-[#0284c7]/90",
                            "text-white",
                            "border-[#00f2ea]",
                            "shadow-[0_0_25px_rgba(0,242,234,0.3)]"
                        );
                        b.classList.add("bg-white/[0.03]", "text-gray-300", "border-white/10");
                    });

                    btn.classList.remove("bg-white/[0.03]", "text-gray-300", "border-white/10");
                    btn.classList.add(
                        "bg-gradient-to-r",
                        "from-[#0d9488]/90",
                        "to-[#0284c7]/90",
                        "text-white",
                        "border-[#00f2ea]",
                        "shadow-[0_0_25px_rgba(0,242,234,0.3)]"
                    );

                    panels.forEach((p) => {
                        if (p.getAttribute("data-comp-panel") === targetId) {
                            p.classList.remove("hidden");
                            p.classList.add("flex");
                        } else {
                            p.classList.remove("flex");
                            p.classList.add("hidden");
                        }
                    });
                });
            });
        });
    </script>

