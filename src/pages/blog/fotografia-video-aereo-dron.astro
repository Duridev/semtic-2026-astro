---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";

const articleData = {
    title: "Fotografía y Grabación Aérea con Drones en Chile: Guía Definitiva 2026 para Empresas y Proyectos",
    description: "Descubre cómo las tomas aéreas en 4K y 360° transforman la producción audiovisual, el marketing inmobiliario y las inspecciones técnicas en Santiago, Valparaíso y todo Chile.",
    slug: "fotografia-video-aereo-dron",
    publishDate: "2026-07-30",
    dateFormatted: "30 de Julio, 2026",
    readTime: "7 min de lectura",
    category: "Servicios con Dron",
    author: "SEMTIC Agencia Digital",
    authorTitle: "Especialistas en Tecnología Aérea & Audiovisual",
    authorImage: "/semtic-favicon.webp",
    canonicalUrl: "https://semtic.cl/blog/fotografia-video-aereo-dron",
    ogImage: "https://semtic.cl/og-servicios.png"
};

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": articleData.title,
    "description": articleData.description,
    "image": articleData.ogImage,
    "datePublished": articleData.publishDate,
    "dateModified": articleData.publishDate,
    "author": {
        "@type": "Organization",
        "name": articleData.author,
        "url": "https://semtic.cl"
    },
    "publisher": {
        "@type": "Organization",
        "name": "SEMTIC Agencia Digital",
        "logo": {
            "@type": "ImageObject",
            "url": "https://semtic.cl/logo-semtic.png"
        }
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": articleData.canonicalUrl
    }
};
---

<Layout
    title={`${articleData.title} | SEMTIC Blog`}
    description={articleData.description}
    image={articleData.ogImage}
    ogType="article"
>
    <!-- Script de Schema.org estructurado para Google -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Barra de progreso de lectura en la parte superior -->
    <div id="read-progress" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-[#2dd4bf] via-[#3b82f6] to-[#00f2ea] z-[120] transition-all duration-150 w-0"></div>

    <!-- Container Principal del Artículo -->
    <article class="pt-32 pb-24 relative overflow-hidden" style="z-index: 10;">
        <!-- Fondo de luces neón -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-[#3b82f6]/10 rounded-full filter blur-[150px] pointer-events-none"></div>
        <div class="absolute top-1/3 right-10 w-96 h-96 bg-[#2dd4bf]/10 rounded-full filter blur-[130px] pointer-events-none"></div>

        <div class="container mx-auto px-4 max-w-5xl">
            <!-- Breadcrumbs -->
            <nav class="flex items-center gap-2 text-xs text-gray-400 mb-8 font-light" aria-label="Breadcrumb">
                <a href="/" class="hover:text-[#2dd4bf] transition-colors">Inicio</a>
                <span>/</span>
                <a href="/blog" class="hover:text-[#2dd4bf] transition-colors">Blog</a>
                <span>/</span>
                <span class="text-gray-200 truncate max-w-xs md:max-w-md font-normal">Fotografía y Grabación Aérea con Drones</span>
            </nav>

            <!-- Encabezado del Artículo -->
            <header class="mb-12">
                <div class="flex flex-wrap items-center gap-3 mb-6">
                    <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-[#3b82f6]/20 border border-[#3b82f6]/40 text-[#3b82f6]">
                        {articleData.category}
                    </span>
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        Pilotos Certificados DGAC Chile
                    </span>
                    <span class="text-xs text-gray-400 font-light">• {articleData.dateFormatted}</span>
                    <span class="text-xs text-[#2dd4bf] font-medium">• {articleData.readTime}</span>
                </div>

                <h1 class="text-3xl md:text-5xl lg:text-6xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-6 leading-tight">
                    Fotografía y Grabación Aérea con Drones en Chile: <span class="text-gradient">Guía Definitiva 2026</span>
                </h1>

                <p class="text-gray-300 text-lg md:text-xl font-light leading-relaxed mb-8 max-w-4xl">
                    Descubre cómo la captura aérea profesional en resolución 4K HDR, las tomas en movimiento FPV y los tours virtuales 360° están elevando la rentabilidad de proyectos inmobiliarios, eventos masivos e inspecciones industriales en Santiago, Valparaíso y regiones.
                </p>

                <!-- Tarjeta de Autor & Redes -->
                <div class="flex flex-wrap items-center justify-between gap-4 p-4 md:p-6 rounded-2xl bg-[#0a0a1a]/70 border border-white/10 backdrop-blur-md">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-[#3b82f6] to-[#00f2ea] p-0.5 shadow-lg">
                            <div class="w-full h-full bg-[#050511] rounded-full flex items-center justify-center font-bold text-white text-sm">
                                ST
                            </div>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-white">{articleData.author}</p>
                            <p class="text-xs text-gray-400">{articleData.authorTitle}</p>
                        </div>
                    </div>

                    <!-- Botones de interacción / compartir (Frontend sin backend) -->
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-gray-400 font-medium hidden sm:inline">Compartir:</span>
                        <a 
                            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(articleData.title + ' ' + articleData.canonicalUrl)}`} 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="p-2.5 rounded-full bg-white/5 border border-white/10 hover:border-emerald-500/50 hover:bg-emerald-500/10 hover:text-emerald-400 text-gray-300 transition-all text-xs"
                            title="Compartir en WhatsApp"
                        >
                            🟢 WhatsApp
                        </a>
                        <a 
                            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(articleData.canonicalUrl)}`} 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="p-2.5 rounded-full bg-white/5 border border-white/10 hover:border-blue-500/50 hover:bg-blue-500/10 hover:text-blue-400 text-gray-300 transition-all text-xs"
                            title="Compartir en LinkedIn"
                        >
                            💼 LinkedIn
                        </a>
                        <button 
                            id="copy-link-btn" 
                            class="p-2.5 rounded-full bg-white/5 border border-white/10 hover:border-[#2dd4bf]/50 hover:bg-[#2dd4bf]/10 hover:text-[#2dd4bf] text-gray-300 transition-all text-xs flex items-center gap-1"
                            title="Copiar Enlace"
                        >
                            🔗 <span id="copy-btn-text">Copiar Enlace</span>
                        </button>
                    </div>
                </div>
            </header>

            <!-- Resumen Ejecutivo / Key Takeaways -->
            <div class="p-6 md:p-8 rounded-3xl bg-gradient-to-br from-[#0a0a20] to-[#0d0d2b] border border-[#2dd4bf]/30 backdrop-blur-xl mb-12 relative overflow-hidden shadow-xl">
                <div class="absolute top-0 left-0 w-2 h-full bg-[#2dd4bf]"></div>
                <h2 class="text-lg font-bold text-[#2dd4bf] mb-4 uppercase tracking-wider flex items-center gap-2 font-[family-name:var(--font-space-grotesk)]">
                    ⚡ Resumen de Puntos Clave
                </h2>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-200">
                    <li class="flex items-start gap-2.5">
                        <span class="text-[#2dd4bf] font-bold text-base">✓</span>
                        <span><strong>Impacto en Ventas:</strong> Las imágenes aéreas 4K incrementan hasta un 68% el interés en anuncios inmobiliarios y publicitarios.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="text-[#2dd4bf] font-bold text-base">✓</span>
                        <span><strong>Seguridad y Normativa:</strong> Operaciones alineadas con la normativa DGAC (DAN 91 / DAN 151) para vuelos urbanos y seguros en Chile.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="text-[#2dd4bf] font-bold text-base">✓</span>
                        <span><strong>Inspección Técnica:</strong> Ahorro del 60% en tiempos de revisión de techumbres, cubiertas y estructuras sin riesgos en altura.</span>
                    </li>
                    <li class="flex items-start gap-2.5">
                        <span class="text-[#2dd4bf] font-bold text-base">✓</span>
                        <span><strong>Tecnología Híbrida:</strong> Combinación de tomas terrestres y aéreas para entregar videos listos para redes sociales o TV.</span>
                    </li>
                </ul>
            </div>

            <!-- Contenido Principal con Tabla de Contenidos -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                <!-- Sidebar con Índice (Table of Contents) -->
                <aside class="lg:col-span-4 hidden lg:block">
                    <div class="sticky top-28 p-6 rounded-2xl bg-[#0a0a1a]/60 border border-white/10 backdrop-blur-md">
                        <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-white/10 pb-2">
                            Índice del Artículo
                        </h3>
                        <nav class="space-y-2 text-xs">
                            <a href="#revolucion-visual" class="block text-gray-300 hover:text-[#2dd4bf] transition-colors py-1">1. La Revolución Visual con Drones</a>
                            <a href="#aplicaciones-clave" class="block text-gray-300 hover:text-[#2dd4bf] transition-colors py-1">2. Aplicaciones Clave por Industria</a>
                            <a href="#tecnologia-utilizada" class="block text-gray-300 hover:text-[#2dd4bf] transition-colors py-1">3. Tecnología: 4K, HDR y FPV</a>
                            <a href="#normativa-chile" class="block text-gray-300 hover:text-[#2dd4bf] transition-colors py-1">4. Normativa y Seguridad en Chile</a>
                            <a href="#por-que-semtic" class="block text-gray-300 hover:text-[#2dd4bf] transition-colors py-1">5. Por qué Elegir SEMTIC Drones</a>
                            <a href="#preguntas-frecuentes" class="block text-gray-300 hover:text-[#2dd4bf] transition-colors py-1">6. Preguntas Frecuentes</a>
                        </nav>

                        <div class="mt-8 pt-6 border-t border-white/10 text-center">
                            <p class="text-xs text-gray-400 mb-4">¿Necesitas tomas aéreas para tu empresa?</p>
                            <a href="/drone" class="block w-full py-2.5 px-4 rounded-xl bg-[#3b82f6] text-white text-xs font-semibold hover:bg-[#2563eb] transition-all">
                                Explorar Servicio de Dron 360°
                            </a>
                        </div>
                    </div>
                </aside>

                <!-- Cuerpo del Artículo -->
                <main class="lg:col-span-8 space-y-12 text-gray-300 leading-relaxed text-base font-light">
                    <!-- Sección 1 -->
                    <section id="revolucion-visual" class="scroll-mt-32">
                        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 font-[family-name:var(--font-space-grotesk)] leading-tight">
                            1. La Revolución Visual de los Drones en Chile
                        </h2>
                        <p class="mb-4">
                            En el competitivo entorno digital actual, el contenido visual estándar a nivel de suelo ha dejado de ser suficiente para captar la atención de audiencias cada vez más exigentes. La incorporación de la <strong class="text-white">fotografía y video aéreo con drones en Chile</strong> ha transformado radicalmente la forma en que las empresas presentan sus proyectos, instalaciones y campañas publicitarias.
                        </p>
                        <p class="mb-6">
                            Desde las vistas panorámicas de la costa de <span class="text-[#2dd4bf] font-medium">Viña del Mar y Valparaíso</span> hasta los proyectos corporativos e industriales en el <span class="text-[#2dd4bf] font-medium">Gran Santiago y la Marga Marga</span>, las tomas aéreas aportan escala, dinamismo y un nivel de sofisticación que diferencia instantáneamente a cualquier marca de sus competidores.
                        </p>
                        
                        <div class="p-6 rounded-2xl bg-white/5 border border-white/10 my-6">
                            <blockquote class="italic text-gray-200 border-l-4 border-[#00f2ea] pl-4">
                                "Un video institucional o comercial que integra perspectivas aéreas transmite solvencia, innovación y visión de futuro. Ya no es un lujo reservado a cine, es un estándar exigido por el mercado."
                            </blockquote>
                        </div>
                    </section>

                    <!-- Sección 2 -->
                    <section id="aplicaciones-clave" class="scroll-mt-32">
                        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 font-[family-name:var(--font-space-grotesk)] leading-tight">
                            2. Principales Aplicaciones por Industria
                        </h2>
                        <p class="mb-6">
                            Los servicios con drones van mucho más allá de una perspectiva bonita. Dependiendo del rubro de tu empresa, los beneficios se traducen en ventas directas u optimización operativa:
                        </p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
                            <!-- Card 1 -->
                            <div class="p-6 rounded-2xl bg-[#0a0a1a]/80 border border-white/10 hover:border-[#3b82f6]/40 transition-all">
                                <div class="text-2xl mb-3">🏢</div>
                                <h3 class="text-lg font-bold text-white mb-2">Inmobiliaria y Arquitectura</h3>
                                <p class="text-xs text-gray-300 leading-relaxed">
                                    Muestra el entorno completo de un condominio, la cercanía a servicios y vistas privilegiadas antes de concluir la edificación. Tours 360° e renders aéreos.
                                </p>
                            </div>
                            <!-- Card 2 -->
                            <div class="p-6 rounded-2xl bg-[#0a0a1a]/80 border border-white/10 hover:border-[#2dd4bf]/40 transition-all">
                                <div class="text-2xl mb-3">🎬</div>
                                <h3 class="text-lg font-bold text-white mb-2">Marketing & Eventos</h3>
                                <p class="text-xs text-gray-300 leading-relaxed">
                                    Cobertura masiva para festivales, lanzamientos de marca, corporativos y comerciales de televisión con tomas cinemáticas de alto impacto.
                                </p>
                            </div>
                            <!-- Card 3 -->
                            <div class="p-6 rounded-2xl bg-[#0a0a1a]/80 border border-white/10 hover:border-[#00f2ea]/40 transition-all">
                                <div class="text-2xl mb-3">🛠️</div>
                                <h3 class="text-lg font-bold text-white mb-2">Inspecciones Técnicas</h3>
                                <p class="text-xs text-gray-300 leading-relaxed">
                                    Evaluación de techumbres, estructuras industriales, paneles solares y cubiertas sin necesidad de arriesgar personal en trabajos de altura.
                                </p>
                            </div>
                            <!-- Card 4 -->
                            <div class="p-6 rounded-2xl bg-[#0a0a1a]/80 border border-white/10 hover:border-emerald-400/40 transition-all">
                                <div class="text-2xl mb-3">🌾</div>
                                <h3 class="text-lg font-bold text-white mb-2">Seguimiento de Obras</h3>
                                <p class="text-xs text-gray-300 leading-relaxed">
                                    Registros periódicos con la misma ruta de vuelo para documentar el avance mensual de proyectos de ingeniería y construcción.
                                </p>
                            </div>
                        </div>
                    </section>

                    <!-- Sección 3 -->
                    <section id="tecnologia-utilizada" class="scroll-mt-32">
                        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 font-[family-name:var(--font-space-grotesk)] leading-tight">
                            3. Tecnología Utilizada: Resoluciones 4K, HDR y FPV
                        </h2>
                        <p class="mb-4">
                            Para lograr un producto final profesional se requiere más que simplemente elevar una cámara al aire. En <strong class="text-white">SEMTIC</strong> empleamos aeronaves pilotadas a distancia (RPA) de última generación equipadas con:
                        </p>
                        
                        <ul class="space-y-3 my-6 pl-4 border-l-2 border-[#3b82f6]">
                            <li class="flex items-start gap-3">
                                <span class="text-[#3b82f6] font-bold">•</span>
                                <span><strong class="text-white">Sensores CMOS de alta resolución:</strong> Captura en 4K UHD a 60 cuadros por segundo y fotografías de alta definición con perfil de color D-Log M para postproducción profesional.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="text-[#3b82f6] font-bold">•</span>
                                <span><strong class="text-white">Estabilización mecánica de 3 ejes:</strong> Fluidez cinemática garantizada incluso en condiciones adversas de viento en la zona costera de Valparaíso o cordillerana de Santiago.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <span class="text-[#3b82f6] font-bold">•</span>
                                <span><strong class="text-white">Tours 360° interactivos:</strong> Integración de fotografías esféricas para generar visitas virtuales navegables en sitios web y Google Maps.</span>
                            </li>
                        </ul>
                    </section>

                    <!-- Sección 4 -->
                    <section id="normativa-chile" class="scroll-mt-32">
                        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 font-[family-name:var(--font-space-grotesk)] leading-tight">
                            4. Normativa y Seguridad en Chile
                        </h2>
                        <p class="mb-4">
                            Volar drones con fines comerciales en Chile exige el estricto cumplimiento de la normativa dictada por la <strong class="text-white">Dirección General de Aeronáutica Civil (DGAC)</strong>, específicamente las normativas DAN 91 y DAN 151.
                        </p>
                        <p class="mb-4">
                            Contratar pilotos informales o aficionados sin credenciales implica graves riesgos legales para las marcas en caso de incidentes en zonas urbanas o eventos. En SEMTIC aseguramos operaciones 100% responsables, previa planificación de espacio aéreo y protocolos de contingencia.
                        </p>
                    </section>

                    <!-- Sección 5 -->
                    <section id="por-que-semtic" class="scroll-mt-32">
                        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 font-[family-name:var(--font-space-grotesk)] leading-tight">
                            5. Por qué Elegir SEMTIC para tus Servicios con Dron
                        </h2>
                        <p class="mb-6">
                            A diferencia de operadoras que solo entregan clips crudos, en SEMTIC combinamos la grabación aérea con nuestra experiencia en <a href="/desarrollo-paginas-web" class="text-[#00f2ea] underline hover:text-white">desarrollo web</a>, <a href="/agencia-marketing-digital" class="text-[#00f2ea] underline hover:text-white">marketing digital</a> y <a href="/publicidad-google-meta-ads" class="text-[#00f2ea] underline hover:text-white">edición orientada a conversión</a>.
                        </p>

                        <div class="p-8 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0d0f36] to-[#0a0a20] border border-[#2dd4bf]/40 my-8 shadow-2xl">
                            <h3 class="text-xl font-bold text-white mb-4">¿Qué incluye nuestro servicio integral?</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-200">
                                <div class="flex items-center gap-2">🔹 Planificación de vuelo y permisos</div>
                                <div class="flex items-center gap-2">🔹 Grabación aérea 4K y terrestre</div>
                                <div class="flex items-center gap-2">🔹 Edición y corrección de color D-Log</div>
                                <div class="flex items-center gap-2">🔹 Formatos optimizados para RRSS y Web</div>
                                <div class="flex items-center gap-2">🔹 Entrega rápida en nube segura</div>
                                <div class="flex items-center gap-2">🔹 Cobertura preferente en V Región y RM</div>
                            </div>
                        </div>
                    </section>

                    <!-- Sección 6: Preguntas Frecuentes -->
                    <section id="preguntas-frecuentes" class="scroll-mt-32 pt-6">
                        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 font-[family-name:var(--font-space-grotesk)] leading-tight">
                            6. Preguntas Frecuentes sobre el Servicio de Drones
                        </h2>

                        <div class="space-y-4">
                            <details class="group p-6 rounded-2xl bg-[#0a0a1a]/80 border border-white/10 transition-all [&_summary::-webkit-details-marker]:hidden">
                                <summary class="flex justify-between items-center cursor-pointer text-white font-semibold text-base">
                                    <span>¿En qué comunas y regiones prestan servicio de dron?</span>
                                    <span class="transition group-open:-rotate-180 text-[#2dd4bf]">👇</span>
                                </summary>
                                <p class="mt-4 text-sm text-gray-300 leading-relaxed font-light">
                                    Tenemos cobertura directa en toda la Región de Valparaíso (Viña del Mar, Valparaíso, Concón, Quilpué, Villa Alemana, Limache, Quillota) y la Región Metropolitana (Santiago). También realizamos desplazamientos a lo largo de todo Chile según requerimientos del proyecto.
                                </p>
                            </details>

                            <details class="group p-6 rounded-2xl bg-[#0a0a1a]/80 border border-white/10 transition-all [&_summary::-webkit-details-marker]:hidden">
                                <summary class="flex justify-between items-center cursor-pointer text-white font-semibold text-base">
                                    <span>¿Qué formato y resolución tienen los videos entregados?</span>
                                    <span class="transition group-open:-rotate-180 text-[#2dd4bf]">👇</span>
                                </summary>
                                <p class="mt-4 text-sm text-gray-300 leading-relaxed font-light">
                                    Entregamos material en calidad 4K Ultra HD a 60fps en formatos MP4/MOV, además de fotografías RAW/JPG de alta resolución. Entregamos archivos listos para campañas en Instagram Reels, TikTok, YouTube o sitios web.
                                </p>
                            </details>

                            <details class="group p-6 rounded-2xl bg-[#0a0a1a]/80 border border-white/10 transition-all [&_summary::-webkit-details-marker]:hidden">
                                <summary class="flex justify-between items-center cursor-pointer text-white font-semibold text-base">
                                    <span>¿Cuánto dura una jornada de vuelo típica?</span>
                                    <span class="transition group-open:-rotate-180 text-[#2dd4bf]">👇</span>
                                </summary>
                                <p class="mt-4 text-sm text-gray-300 leading-relaxed font-light">
                                    Ofrecemos paquetes ajustados por horas de vuelo o jornadas completas (media jornada o jornada entera), contando con baterías múltiples de alta autonomía y sistemas de recarga rápida en terreno para garantizar continuidad operativa.
                                </p>
                            </details>
                        </div>
                    </section>
                </main>
            </div>

            <!-- Card de CTA al finalizar el artículo -->
            <div class="mt-20 p-10 md:p-14 rounded-3xl bg-gradient-to-r from-[#0a0a20] via-[#0d123d] to-[#0a0a20] border border-[#3b82f6]/40 backdrop-blur-xl text-center relative overflow-hidden shadow-2xl">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-1 bg-gradient-to-r from-transparent via-[#00f2ea] to-transparent"></div>
                <h2 class="text-3xl md:text-4xl font-[family-name:var(--font-space-grotesk)] font-bold text-white mb-4">
                    ¿Listo para elevar la perspectiva de tu proyecto?
                </h2>
                <p class="text-gray-300 text-base md:text-lg max-w-2xl mx-auto mb-8 font-light">
                    Explora nuestra página de servicios con dron, revisa ejemplos de producción y solicita tu presupuesto personalizado sin compromiso.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
