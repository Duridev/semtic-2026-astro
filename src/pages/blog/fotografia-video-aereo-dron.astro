    <!-- Client Script para Barra de Lectura y Copiar Enlace -->
    <script>
        // Actualizar barra de progreso de lectura al scrollear
        window.addEventListener('scroll', () => {
            const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            const progressEl = document.getElementById('read-progress');
            if (progressEl) {
                progressEl.style.width = scrolled + '%';
            }
        });

        // Copiar enlace al portapapeles
        const copyBtn = document.getElementById('copy-link-btn');
        const copyBtnText = document.getElementById('copy-btn-text');
        if (copyBtn && copyBtnText) {
            copyBtn.addEventListener('click', () => {
                navigator.clipboard.writeText(window.location.href);
                const originalText = copyBtnText.innerText;
                copyBtnText.innerText = '¡Enlace Copiado!';
                copyBtn.classList.add('text-[#2dd4bf]', 'border-[#2dd4bf]');
                setTimeout(() => {
                    copyBtnText.innerText = originalText;
                    copyBtn.classList.remove('text-[#2dd4bf]', 'border-[#2dd4bf]');
                }, 2500);
            });
        }
    </script>
